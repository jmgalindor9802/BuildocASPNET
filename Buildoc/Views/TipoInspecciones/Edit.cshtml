@model TipoInspeccion

@{
    ViewData["Title"] = "Edit";
}

<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Categoria" class="control-label"></label>
                <select asp-for="Categoria" class="form-control" asp-items="ViewBag.Categorias">
                    <option value="">Seleccione una categoría</option>
                </select>
                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <!-- Mostrar archivos ya subidos -->
            <h5>Archivos relacionados</h5>
            <ul class="list-group">
                @foreach (var archivo in Model.Archivos)
                {
                    <li id="file-@archivo.Id" class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="@archivo.FilePath" target="_blank">@archivo.FileName</a>
                        <button type="button" class="btn btn-danger btn-sm" onclick="deleteFile('@archivo.Id')">Eliminar</button>
                    </li>
                }
            </ul>

            <!-- Sección para agregar nuevos archivos -->
            <div class="form-group">
                <label for="UploadedFiles">Subir Archivos</label>
                <input type="file" name="UploadedFiles" id="UploadedFiles" multiple />
                </br>
                <span id="fileSizeError" class="text-danger"></span> <!-- Este elemento mostrará el mensaje de error -->

            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script type="text/javascript">
    function deleteFile(fileId) {
        if (confirm("¿Estás seguro de que quieres eliminar este archivo?")) {
            $.ajax({
                url: '@Url.Action("DeleteFile", "TipoInspecciones")',
                type: 'POST',
                data: { fileId: fileId },
                success: function (response) {
                    if (response.success) {
                        alert('Archivo eliminado exitosamente.');
                        // Eliminar el elemento del DOM sin recargar la página
                        document.getElementById('file-' + fileId).remove();
                    } else {
                        alert('Hubo un error al eliminar el archivo.');
                    }
                }
            });
        }
    }
</script>


<script src="/js/tamanoArchivos.js"></script>