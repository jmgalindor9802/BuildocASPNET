<script>
    function updateTimeRemaining() {
        var rows = document.querySelectorAll("#example1 tbody tr");

        rows.forEach(function (row) {
            var tiempoRestanteCell = row.querySelector("td:nth-child(7)"); // Ajusta el índice de la columna según tu tabla
            var respondButton = row.querySelector('.respond-item'); // Selecciona el botón de responder
            var estadoCell = row.querySelector("td:nth-child(6)"); // Ajusta el índice si es necesario para el estado

            // Asegúrate de que el atributo data-endtime tenga un valor
            if (tiempoRestanteCell && tiempoRestanteCell.dataset.endtime) {
                var endTime = new Date(tiempoRestanteCell.dataset.endtime);
                var now = new Date();
                var timeDiff = endTime - now;  // Diferencia de tiempo en milisegundos
                var estado = estadoCell ? estadoCell.textContent.trim() : "";

                if (estado === "Programada") { // Solo modificar si está en estado Programada
                    if (timeDiff > 0) {
                        // Si aún no ha llegado la fecha/hora, calcular el tiempo restante
                        var days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));

                        if (days > 0) {
                            tiempoRestanteCell.innerText = `${days}d ${hours}h restantes`;
                        } else if (hours > 0) {
                            tiempoRestanteCell.innerText = `${hours}h ${minutes}m restantes`;
                        } else {
                            tiempoRestanteCell.innerText = `${minutes}m restantes`;
                        }

                        // Deshabilitar el botón ya que aún no ha llegado la hora de la inspección
                        if (respondButton) {
                            respondButton.classList.add('disabled');
                        }
                    } else {
                        // Si ya ha pasado la fecha/hora, mostrar "Por responder"
                        tiempoRestanteCell.innerHTML = `<span class="badge badge-sin-responder">Por responder</span>`;

                        // Habilitar el botón si la inspección ya pasó
                        if (respondButton) {
                            respondButton.classList.remove('disabled');
                        }
                    }
                } else {
                    // Si el estado no es Programada, no mostrar ningún texto en esta celda
                    tiempoRestanteCell.innerText = "No aplica";

                    // Deshabilitar el botón si no aplica
                    if (respondButton) {
                        respondButton.classList.add('disabled');
                    }
                }
            } else {
                tiempoRestanteCell.innerText = "No aplica";

                // Deshabilitar el botón si no hay tiempo aplicable
                if (respondButton) {
                    respondButton.classList.add('disabled');
                }
            }
        });
    }

    // Actualizar cada minuto
    setInterval(updateTimeRemaining, 60000);

    // Llamar a la función una vez al cargar la página
    updateTimeRemaining();


</script>


<script>
    // Esta parte asegura que los botones se deshabiliten o habiliten correctamente al cargar la página
    document.addEventListener("DOMContentLoaded", function () {
        var respondButtons = document.querySelectorAll('.respond-item');

        respondButtons.forEach(function (button) {
            var endTime = new Date(button.getAttribute('data-endtime'));
            var now = new Date();

            if (now >= endTime) {
                // Si el tiempo ya pasó, habilitar el botón
                button.classList.remove('disabled');

            } else {
                // Si el tiempo aún no ha pasado, deshabilitar el botón
                button.classList.add('disabled');
                button.classList.remove('btn-primary');
            }
        });
    });
</script>
