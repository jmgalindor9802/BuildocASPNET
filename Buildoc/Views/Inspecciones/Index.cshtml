    <script src="~/js/datatable-config.js"></script>
    <script src="/espanol.js"></script>
    <script>
        $(document).ready(function () {
            // Inicializa la DataTable con la configuración deseada
            let table = $('#example1').DataTable();

            // Función para obtener proyectos únicos del DataTable
            function getProyectos() {
                const proyectos = [];
                table.rows().every(function () {
                    const data = this.data();
                    const proyecto = data[3]; // Asume que la columna de proyecto es la 3ra (índice 2)
                    if (!proyectos.includes(proyecto)) {
                        proyectos.push(proyecto);
                    }
                });
                return proyectos;
            }

            // Función para obtener inspectores únicos del DataTable
            function getInspectores() {
                const inspectores = [];
                table.rows().every(function () {
                    const data = this.data();
                    const inspector = data[4]; 
                    if (!inspectores.includes(inspector)) {
                        inspectores.push(inspector);
                    }
                });
                return inspectores;
            }

            // Función para obtener tipos de inspeccion únicos del DataTable
            function getTipos() {
                const tipos = [];
                table.rows().every(function () {
                    const data = this.data();
                    const tipo = data[2]; // Asume que la columna de proyecto es la 3ra (índice 2)
                    if (!tipos.includes(tipo)) {
                        tipos.push(tipo);
                    }
                });
                return tipos;
            }


            // Llenar el select con las opciones de proyecto
            function fillProyectoSelect() {
                const proyectoFilterEl = $('#proyecto-filter');
                proyectoFilterEl.empty(); // Limpiar el select antes de llenarlo
                proyectoFilterEl.append('<option value="">Todos los proyectos</option>'); // Opción predeterminada
                const proyectos = getProyectos();
                proyectos.forEach(proyecto => {
                    const option = $('<option></option>').val(proyecto).text(proyecto);
                    proyectoFilterEl.append(option);
                });
            }

            // Llenar el select con las opciones de inspectores
            function fillInspectorSelect() {
                const inspectorFilterEl = $('#inspector-filter');
                inspectorFilterEl.empty(); // Limpiar el select antes de llenarlo
                inspectorFilterEl.append('<option value="">Todos los inspectores</option>'); // Opción predeterminada
                const inspectores = getInspectores();
                inspectores.forEach(inspector => {
                    const option = $('<option></option>').val(inspector).text(inspector);
                    inspectorFilterEl.append(option);
                });
            }


            // Llenar el select con las opciones de inspectores
            function fillTipoSelect() {
                const tipoFilterEl = $('#tipo-filter');
                tipoFilterEl.empty(); // Limpiar el select antes de llenarlo
                tipoFilterEl.append('<option value="">Todos los tipos de inspecciones</option>'); // Opción predeterminada
                const tipos = getTipos();
                tipos.forEach(tipo => {
                    const option = $('<option></option>').val(tipo).text(tipo);
                    tipoFilterEl.append(option);
                });
            }

            // Inicializa el select con proyectos
            fillProyectoSelect();

            // Inicializa el select con inspectores
            fillInspectorSelect();

            // Inicializa el select con tipos
            fillTipoSelect();

            // Agregar evento de cambio al select para filtrar la tabla
            $('#proyecto-filter').on('change', function () {
                const proyectoFilter = $(this).val();
                table.column(3).search(proyectoFilter).draw(); // Filtra la columna de proyectos
            });

            // Agregar evento de cambio al select para filtrar la tabla
            $('#inspector-filter').on('change', function () {
                const inspectorFilter = $(this).val();
                table.column(4).search(inspectorFilter).draw(); // Filtra la columna de proyectos
            });

            // Agregar evento de cambio al select para filtrar la tabla
            $('#tipo-filter').on('change', function () {
                const tipoFilter = $(this).val();
                table.column(2).search(tipoFilter).draw(); // Filtra la columna de proyectos
            });

            // Agregar función de búsqueda personalizada si es necesario
            $.fn.dataTable.ext.search.push(
                function (settings, data, dataIndex) {
                    const proyectoFilter = $('#proyecto-filter').val();
                    const proyecto = data[3]; 
                    return proyectoFilter === "" || proyecto === proyectoFilter;
                }
            );

     
        });


    </script>


