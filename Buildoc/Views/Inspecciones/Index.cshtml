

    @model IEnumerable<Buildoc.Models.Inspeccion>



    @{
        ViewData["Title"] = "Inspecciones";
        var esCoordinador = User.IsInRole("Coordinador");
        var esAdmin= User.IsInRole("Administrador");
        var usuarioId = ViewBag.UsuarioId as string;
        var esResidente = User.IsInRole("Residente");
    }
    <header>
    <style>
    .disabled {
        pointer-events: none;
        opacity: 0.5;
    }

        .map-container {
            position: relative;
            height: 100%;
            min-height: 400px;
        }

        .charts-container {
            padding: 15px;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            margin-bottom: 20px;
        }


    </style>
    </header>

    <div class="container-page">

        <div class ="row mb-4 align-items-center text-white p-3" style="background-color: #001f3f;">
            <div class="col-12 d-flex justify-content-between align-items-center">
                <h1 class="mb-0">
                <i class="fas fa-paste "></i> Inspecciones
                </h1><p class="mb-0">

                @if (esAdmin)
                    {
                        <a href="@Url.Action("Index", "TipoInspecciones")" class="btn btn-light">
                            <i class="fas fa-clipboard-list"></i>
                        <span class="d-none d-md-inline">Tipos de inspecciones</span>
                        </a>

                    }

                    @if (esCoordinador)
                    {
                        <a href="#" id="createNewModal" class="create-new btn btn-light"
                           data-url="@Url.Action("Create", "Inspecciones")"
                           data-title="Crear nueva inspección" data-action="create">
                            <i class="fas fa-calendar-plus"></i>
                        <span class="d-none d-md-inline">Programar inspección</span>
                        </a>
                    }
                </p>
            </div>
        </div>

    <div class="row">
        <!-- Caja de información para inspecciones programadas -->
        <div class="col-6 col-md mb-1">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>@ViewBag.CountProgramadas</h3>
                    <p>Programadas</p>
                </div>
                <div class="icon">
                    <i class="far fa-clock" style="font-size:55px;"></i>
                </div>
                <a href="@Url.Action("Programadas", "Inspecciones")" class="small-box-footer">
                    Ver detalles <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>

        <!-- Caja de información para inspecciones pendientes de revisión -->
        <div class="col-6 col-md mb-1">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>@ViewBag.CountPendienteRevision</h3>
                    <p>Por aprobar</p>
                </div>
                <div class="icon">
                    <i class="far fa-flag" style="font-size:55px;"></i>
                </div>
                <a href="@Url.Action("PendientesRevision", "Inspecciones")" class="small-box-footer">
                    Ver detalles <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>

        <!-- Caja de información para inspecciones sin responder -->
        <div class="col-6 col-md mb-1">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>@ViewBag.CountSinResponder</h3>
                    <p>Sin responder</p>
                </div>
                <div class="icon">
                    <i class="far fa-flag" style="font-size:55px;"></i>
                </div>
                <a href="@Url.Action("SinResponder", "Inspecciones")" class="small-box-footer">
                    Ver detalles <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>

        <!-- Caja de información para inspecciones desaprobadas -->
        <div class="col-6 col-md mb-1">
            <div class="small-box bg-indigo">
                <div class="inner">
                    <h3>@ViewBag.CountDesaprobadas</h3>
                    <p>Desaprobadas</p>
                </div>
                <div class="icon">
                    <i class="far fa-thumbs-down" style="font-size:55px;"></i>
                </div>
                <a href="@Url.Action("Desaprobadas", "Inspecciones")" class="small-box-footer">
                    Ver detalles <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>

        <!-- Caja de información para inspecciones aprobadas -->
        <div class="col-6 col-md mb-1">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@ViewBag.CountAprobadas</h3>
                    <p>Aprobadas</p>
                </div>
                <div class="icon">
                    <i class="far fa-check-circle" style="font-size:55px;"></i>
                </div>
                <a href="@Url.Action("Aprobadas", "Inspecciones")" class="small-box-footer">
                    Ver detalles <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
    </div>



    <!-- Sección para gráficos y mapa -->
    <div class="row">
        <!-- Columna izquierda: Gráficas -->
        <div class="col-lg-6 col-md-12 col-12">
            <div class="row">
            <!-- Primera gráfica -->
            <div class="col-md-6 col-sm-12">
                <div class="charts-container">
                    <h5>Inspecciones programadas</h5>
                    <canvas id="inspectionPieChart" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica más pequeña -->
                </div>
            </div>
               @if (!esResidente)
                            {
            <!-- Segunda gráfica -->
            <div class="col-md-6 col-sm-12">
                <div class="charts-container">
                        <h5>Próx. 7 Días</h5>
                    <canvas id="inspectionPieChart2" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica más pequeña -->
                </div>
            </div>
                            }
                               @if (esResidente)
                            {
                <div class="col-md-6 col-sm-12">
                    <div class="charts-container">
                        <h5>Progreso de Inspecciones</h5>
                        <canvas id="progressChart" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica -->
                    </div>
                    </div>
                            }
            
            </div>
            <div class="row">
            <!-- Tercera gráfica -->
            <div class="col-md-6 col-sm-12">
                <div class="charts-container">
                        <h5>Por tipos de Inspección</h5>
                        <canvas id="tipoInspeccionPieChart" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica más pequeña -->
                </div>
            </div>

            <!-- Cuarta gráfica -->
            <div class=" col-md-6 col-sm-12">
                <div class="charts-container">
                        <h5>Urgencia de programadas</h5>
                        <canvas id="tiempoRestanteBarChart" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica más pequeña -->
                </div>
            </div>
        </div>
        </div>

        <!-- Columna derecha: Mapa -->
        <div class="col-lg-6 col-md-12 col-12 d-flex flex-column">
            <div class="map-container">
                <!-- Contenedor para los controles del mapa -->
                <div id="map-controls" class="position-absolute" style="top: 10px; left: 10px; z-index: 1000;">
                    <button id="zoom-in" class="btn btn-light" title="Acercar" style="margin-bottom: 5px;">
                        <i class="fas fa-search-plus"></i>
                    </button>
                    <button id="zoom-out" class="btn btn-light" title="Alejar" style="margin-bottom: 5px;">
                        <i class="fas fa-search-minus"></i>
                    </button>
                    <button id="zoom-reset" class="btn btn-light" title="Restablecer zoom">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>

                <!-- Filtro para inspecciones dentro del mapa -->
                <div id="map-filter" class="position-absolute p-2 bg-white border rounded" style="top: 10px; right: 10px; z-index: 1000;">
                    <label for="filterEstado" class="form-label">Filtrar por estado:</label>
                    <select id="filterEstado" class="form-control">
                        <option value="all">Todos</option>
                        <option value="0">Por aprobar</option>
                        <option value="3">Programada</option>
                        <option value="4">Sin responder</option>
                        <option value="5">Aprobada</option>
                        <option value="6">Desaprobada</option>
                    </select>
                </div>

                <!-- Mapa -->
                <div id="map" ></div>
            </div>
        </div>
    </div>

        
                <tr>
            <div class ="row mt-3">
                    <div class="form-group mb-3 col-4">
                        <label  class="control-label">Filtrar por proyecto</label>
                        <select id="proyecto-filter" class="form-control">
                        <option value="">Todos los proyectos</option>
                        <!-- Las opciones se llenarán dinámicamente con los proyectos -->
                    </select>
                    </div>
                       @if (esCoordinador)
                            {
            <div class="form-group mb-3 col-4">
                <label class="control-label">Filtrar por inspector</label>
                <select id="inspector-filter" class="form-control">
                    <option value="">Todos los inspectores</option>
                    <!-- Las opciones se llenarán dinámicamente con los proyectos -->
                </select>
            </div>
                            }
                <div class="form-group mb-3 col-4">
                    <label class="control-label">Filtrar por tipo de inspección</label>
                    <select id="tipo-filter" class="form-control">
                        <option value="">Todos los tipos</option>
                        <!-- Las opciones se llenarán dinámicamente con los proyectos -->
                    </select>
                </div>
            </div>
                </tr>
      
 
