@model Buildoc.Models.Inspeccion
@{
    Layout = null;
}

<div class="row">

    <!-- Columna Derecha (Datos del Proyecto) -->
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del proyecto</h6>
                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Nombre)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Departamento)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Departamento)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Municipio)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Municipio)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Direccion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Direccion)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Cliente)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Cliente)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Descripcion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Descripcion)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Línea de Tiempo Combinada -->
<div class="row mt-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-history"></i> Línea de Tiempo</h6>
                <div class="timeline">
                    <!-- Evento de Inspección -->
                    <div class="timeline-item">
                        <i class="fas fa-calendar-check bg-blue"></i>
                        <div class="timeline-item">
                            <span class="time"><i class="fas fa-clock"></i> @Model.FechaProgramacion.ToString("dd/MM/yyyy HH:mm")</span>
                            <h3 class="timeline-header">Inspección programada</h3>
                            <div class="timeline-body">
                                <p><strong>Tipo de Inspección:</strong> @Model.TipoInspeccion.Descripcion</p>
                                <p><strong>Responder:</strong> @Model.FechaInspeccion</p>
                                <p><strong>Objetivo:</strong> @Model.Objetivo</p>
                                <p><strong>Descripción:</strong> @Model.Descripcion</p>
                               
                                <p><strong>Inspector:</strong> @Model.Inspector.NombreCompleto
                                    <small>(@Html.DisplayFor(model => model.Inspector.Email))</small>
                                </p>
                                <p>
                                    <strong>Estado:</strong>
                                    <span class="badge @(Model.Estado == EstadoInspeccion.Programada ? "badge-programada" :
                                          Model.Estado == EstadoInspeccion.PendientesDeRevision ? "badge-pendiente-revision" :
                                          Model.Estado == EstadoInspeccion.SinResponder ? "badge-sin-responder" :
                                          Model.Estado == EstadoInspeccion.Aprobada ? "badge-aprobada" : "")">
                                        @Html.DisplayFor(model => model.Estado)
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Respuesta de Inspección -->
                    @if (Model.Respuesta != null)
                    {
                        <div class="timeline-item">
                            <i class="fas fa-reply bg-green"></i>
                            <div class="timeline-item">
                                <span class="time"><i class="fas fa-clock"></i> @Model.Respuesta.FechaRespuesta.ToString("dd/MM/yyyy HH:mm")</span>
                                <h3 class="timeline-header">Respuesta de Inspección</h3>
                                <div class="timeline-body">
                                    <p><strong>Resultado:</strong> @Model.Respuesta.Resultado</p>
                                    <p><strong>Observaciones:</strong> @Model.Respuesta.Observaciones</p>
                                    <p><strong>Documentación Completa:</strong> @(Model.Respuesta.DocumentacionCompleta ? "Sí" : "No")</p>
                                    <p><strong>Acciones Correctivas:</strong> @(Model.Respuesta.AccionesCorrectivas ? "Sí" : "No")</p>
                                    @if (!string.IsNullOrEmpty(Model.Respuesta.AccionesCorrectivasLista))
                                    {
                                        <p><strong>Lista de Acciones Correctivas:</strong> @Model.Respuesta.AccionesCorrectivasLista</p>
                                    }
                                    <p><strong>Recomendaciones Futuras:</strong> @(Model.Respuesta.RecomendacionesFuturas ? "Sí" : "No")</p>
                                    @if (!string.IsNullOrEmpty(Model.Respuesta.RecomendacionesFuturasList))
                                    {
                                        <p><strong>Lista de Recomendaciones Futuras:</strong> @Model.Respuesta.RecomendacionesFuturasList</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Novedades -->
                    @if (Model.Novedades != null && Model.Novedades.Any())
                    {
                        // Variable para almacenar el estado previo
                        EstadoInspeccion? estadoPrevio = null;

                        @foreach (var novedad in Model.Novedades.OrderBy(n => n.FechaCreacion))
                        {
                            <div class="timeline-item">
                                <i class="fas fa-info-circle bg-yellow"></i>
                                <div class="timeline-item">
                                    <span class="time"><i class="fas fa-clock"></i> @novedad.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                                    <h3 class="timeline-header">Novedad</h3>
                                    <div class="timeline-body">
                                        <p>@novedad.Comentario</p>

                                        <!-- Verifica si el estado actual es diferente al estado previo -->
                                        @if (estadoPrevio != Model.Estado)
                                        {
                                            <span class="badge @(Model.Estado == EstadoInspeccion.Aprobada ? "badge-aprobada" :
                              Model.Estado == EstadoInspeccion.Desaprobada ? "badge-desaprobada" :
                              Model.Estado == EstadoInspeccion.Programada ? "badge-programada" :
                              Model.Estado == EstadoInspeccion.PendientesDeRevision ? "badge-pendiente-revision" :
                              Model.Estado == EstadoInspeccion.SinResponder ? "badge-sin-responder" : "")">
                                                @Html.DisplayFor(model => model.Estado)
                                            </span>

                                            <!-- Actualiza el estado previo -->
                                            estadoPrevio = Model.Estado;
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="timeline-item">
                            <i class="fas fa-info-circle bg-gray"></i>
                            <div class="timeline-item">
                                <span class="time"><i class="fas fa-clock"></i> No disponible</span>
                                <h3 class="timeline-header">Novedades</h3>
                                <div class="timeline-body">
                                    <p>No hay novedades relacionadas con esta inspección.</p>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/detalleTipoInspeccion.js"></script>
<script src="/js/detalleInspeccion.js"></script>
<script>
    $(document).ready(function () {
        function handleResponse(data) {
            if (data.success) {
                // Actualizar el estado de la inspección
                var estadoBadge = $('.timeline-item .timeline-body .badge');
                estadoBadge.removeClass().addClass('badge ' + getBadgeClass(data.inspeccion.Estado));
                estadoBadge.text(data.inspeccion.Estado);

                // Agregar la nueva novedad a la línea de tiempo
                var novedadesTimeline = $('.timeline');
                var novedadHtml = `
        <div class="timeline-item">
            <i class="fas fa-info-circle bg-yellow"></i>
            <div class="timeline-item">
                <span class="time"><i class="fas fa-clock"></i> ${data.inspeccion.Novedades[data.inspeccion.Novedades.length - 1].FechaCreacion}</span>
                <h3 class="timeline-header">Novedad</h3>
                <div class="timeline-body">
                    <p>${data.inspeccion.Novedades[data.inspeccion.Novedades.length - 1].Comentario}</p>
                    ${data.inspeccion.Estado === "Aprobada"
                        ? '<p><strong>Estado Actual:</strong> Aprobado</p>'
                        : data.inspeccion.Estado === "Desaprobada"
                            ? '<p><strong>Estado Actual:</strong> Desaprobado</p>'
                            : ''
                    }
                </div>
            </div>
        </div>
    `;

                novedadesTimeline.append(novedadHtml);

                // Mostrar el mensaje de éxito
                toastr.success('@TempData["SuccessMessage"]');
            } else {
                toastr.error(data.message);
            }
        }

        $('#createNovedadForm').submit(function (event) {
            event.preventDefault();
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: handleResponse
            });
        });
    });

</script>