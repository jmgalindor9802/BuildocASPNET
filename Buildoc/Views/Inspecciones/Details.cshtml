@model Buildoc.Models.Inspeccion
@using Buildoc.Models.Inspecciones


@{
    Layout = null;
}


    <div class="row">
        <!-- Columna Izquierda (Datos de la Inspección) -->
        <div class="col-md-6">
   

          
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FechaInspeccion)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaInspeccion)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FechaProgramacion)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaProgramacion)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Objetivo)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Objetivo)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descripcion)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TipoInspeccion)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TipoInspeccion.Descripcion)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Inspector)</dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Inspector.NombreCompleto)
                            <small>(@Html.DisplayFor(model => model.Inspector.Email))</small>
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Estado)</dt>
                
                <dd class="col-sm-8">
                    <span class="badge @(Model.Estado == EstadoInspeccion.Programada ? "badge-programada" :
                                          Model.Estado == EstadoInspeccion.PendientesDeRevision ? "badge-pendiente-revision" :
                                          Model.Estado == EstadoInspeccion.SinResponder ? "badge-sin-responder" :
                                          Model.Estado == EstadoInspeccion.Aprobada ? "badge-aprobada" : "")">
                        @Html.DisplayFor(model => model.Estado)
                    </span>
                </dd>
                    </dl>
        
        </div>
        </div>
        <!-- Columna Derecha (Datos del Proyecto) -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del proyecto</h6>

                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Nombre)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Departamento)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Departamento)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Municipio)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Municipio)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Direccion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Direccion)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Cliente)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Cliente)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Descripcion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Descripcion)</dd>
                </dl>


                </div>
            </div>
        </div>
    </div>

<!-- Mostrar detalles de la respuesta si está disponible -->

@if (Model.Respuesta != null)
{
    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-primary"><i class="fas fa-reply"></i> Detalles de la respuesta</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.FechaRespuesta)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => Model.Respuesta.FechaRespuesta)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.Resultado)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => Model.Respuesta.Resultado)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.Observaciones)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => Model.Respuesta.Observaciones)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.EsNecesariaInspeccionAdicional)</dt>
                        <dd class="col-sm-8">
                            @if (Model.Respuesta.EsNecesariaInspeccionAdicional)
                            {
                                @Html.Raw("Sí")
                            }
                            else
                            {
                                @Html.Raw("No")
                            }
                        </dd>


                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.AccionesCorrectivas)</dt>
                        <dd class="col-sm-8">
                            @if (Model.Respuesta.AccionesCorrectivas)
                            {
                                @Html.Raw("Sí")
                            }
                            else
                            {
                                @Html.Raw("No")
                            }
                        </dd>
        
                        @if (!string.IsNullOrEmpty(Model.Respuesta.AccionesCorrectivasLista))
                        {
                            <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.AccionesCorrectivasLista)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => Model.Respuesta.AccionesCorrectivasLista)</dd>
                        }

                       

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.DocumentacionCompleta)</dt>
                        <dd class="col-sm-8">
                            @if (Model.Respuesta.DocumentacionCompleta)
                            {
                                @Html.Raw("Sí")
                            }
                            else
                            {
                                @Html.Raw("No")
                            }
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.RecomendacionesFuturas)</dt>
                        <dd class="col-sm-8">
                            @if (Model.Respuesta.RecomendacionesFuturas)
                            {
                                @Html.Raw("Sí")
                            }
                            else
                            {
                                @Html.Raw("No")
                            }
                        </dd>
                        @if (!string.IsNullOrEmpty(Model.Respuesta.RecomendacionesFuturasList))
                        {
                            <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.RecomendacionesFuturasList)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => Model.Respuesta.RecomendacionesFuturasList)</dd>
                        }
                       
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => Model.Respuesta.EstadoRespuestaInspeccion)</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Respuesta.EstadoRespuestaInspeccion == EstadoRespuestaInspeccion.Respondida ? "badge-aprobada" :
                                 Model.Respuesta.EstadoRespuestaInspeccion == EstadoRespuestaInspeccion.Pendiente ? "badge-en-proceso" :
                                 "badge-default")">
                                @Html.DisplayFor(model => Model.Respuesta.EstadoRespuestaInspeccion)                            
                            </span>
                        </dd> 
                    </dl>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>No hay respuesta disponible para esta inspección.</p>
}
<!-- Mostrar novedades relacionadas con la inspección -->
@if (Model.Novedades != null && Model.Novedades.Any())
{
    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-primary"><i class="fas fa-bell"></i> Novedades relacionadas</h6>
                    <dl class="row mb-0">
                        @foreach (var novedad in Model.Novedades)
                        {
                            <dt class="col-sm-4">Comentario:</dt>
                            <dd class="col-sm-8">@novedad.Comentario</dd>
                            <dt class="col-sm-4">Fecha:</dt>
                            <dd class="col-sm-8">@novedad.FechaCreacion.ToString("dd/MM/yyyy")</dd>
                            <hr />
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>No hay novedades relacionadas con esta inspección.</p>
}
<script src="/js/detalleTipoInspeccion.js"></script>
<script src="/js/detalleInspeccion.js"></script>