@model Buildoc.Models.Inspecciones.InspeccionCreateViewModel

@{
    Layout = null;

}

<div class=" mb-4">
    <!-- Margen inferior para el formulario -->
    <form asp-action="Create" class="ml-3 mr-3" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row">
            <div class="col-lg-8">

                <div class="form-group">
                        <label asp-for="Inspeccion.ProyectoId" class="control-label"></label>
                    <select asp-for="Inspeccion.ProyectoId" class="form-control" asp-items="ViewBag.ProyectoId" id="ProyectoId" ></select>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Inspeccion.FechaInspeccion" class="control-label"></label>
                            <input asp-for="Inspeccion.FechaInspeccion" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Inspeccion.FechaInspeccion" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6" >
                        <div class="form-group">
                            <label asp-for="Inspeccion.DuracionHoras" class="control-label"></label>
                            <input asp-for="Inspeccion.DuracionHoras" class="form-control" id="DuracionHoras" />
                            <span asp-validation-for="Inspeccion.DuracionHoras" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group form-check">
                    <input asp-for="Inspeccion.EsTodoElDia" class="form-check-input" id="EsTodoElDia" />
                    <label asp-for="Inspeccion.EsTodoElDia" class="form-check-label"></label>
                    <span asp-validation-for="Inspeccion.EsTodoElDia" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Inspeccion.Objetivo" class="control-label"></label>
                    <input asp-for="Inspeccion.Objetivo" class="form-control" />
                    <span asp-validation-for="Inspeccion.Objetivo" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Inspeccion.Descripcion" class="control-label"></label>
                    <textarea asp-for="Inspeccion.Descripcion" class="form-control"></textarea>
                    <span asp-validation-for="Inspeccion.Descripcion" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Inspeccion.InspectorId" class="control-label"></label>
                    <select asp-for="Inspeccion.InspectorId" class="form-control" id="InspectorId">
                        <option value="">Selecciona un proyecto primero</option>
                    </select>
                </div>

            </div>
            <div class="col-lg-4 order-1 order-md-2">

                <div class="form-group mb-3">
                    <label class="control-label">Categoría de Inspección</label>
                    <select id="CategoriaInspeccion" name="CategoriaInspeccion" class="form-control">
                        <option value="" disabled selected>Seleccionar Categoría</option>
                    </select>
                </div>


                <div class="form-group mb-3">
                    <!-- Margen inferior para separar del siguiente contenido -->
                    <label asp-for="Inspeccion.TipoInspeccionId" class="control-label"></label>
                    <select asp-for="Inspeccion.TipoInspeccionId" class="form-control" asp-items="ViewBag.TipoInspeccionId" id="TipoInspeccionId">
                        <option value="" disabled selected>Seleccionar</option>
                    </select>
                </div>
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del tipo de inspección</h6>                
                <p><span  style="display: block; font-size: 0.9em;">Descripción</span> <span id="TipoInspeccionDescripcion" class="text-muted"></span></p>

                <div id="archivosRelacionados" class="mt-3">
                    <h6 class="text-primary"><i class="fas fa-file-alt"></i> Archivos relacionados</h6>
                    <ul id="listaArchivos" class="list-unstyled"></ul>
                </div>


    
               
            </div>
        
        </div>
        <div class="form-group">
            <label for="UploadedFiles">Subir Archivos</label>
            <input type="file" name="UploadedFiles" id="UploadedFiles" multiple />
        </div>
    </form>
</div>

<script src="/js/toggleDuracionHoras.js"></script>
<script src="/js/detalleTipoInspeccion.js"></script>
<script>
    $(document).ready(function () {
        // Función para cargar los inspectores según el proyecto seleccionado
        function cargarInspectores(proyectoId) {
            var $inspectorSelect = $('#InspectorId');
            $inspectorSelect.empty(); // Limpia el select antes de llenarlo

            if (proyectoId) {
                $.getJSON('@Url.Action("GetInspectoresByProyecto")', { proyectoId: proyectoId }, function (data) {
                    if (data.length > 0) {
                        $.each(data, function (index, item) {
                            $inspectorSelect.append($('<option>', {
                                value: item.id,
                                text: item.nombreCompleto
                            }));
                        });
                    } else {
                        $inspectorSelect.append($('<option>', {
                            value: '',
                            text: 'No hay residentes asignados a este proyecto',
                            disabled: true
                        }));
                    }
                });
            } else {
                $inspectorSelect.append($('<option>', {
                    value: '',
                    text: 'Selecciona un proyecto primero',
                    disabled: true
                }));
            }
        }
        $(document).ready(function () {
            function cargarArchivos(tipoInspeccionId) {
                var $listaArchivos = $('#listaArchivos');
                $listaArchivos.empty();  // Limpia la lista antes de agregar los nuevos archivos

                if (tipoInspeccionId) {
                    $.getJSON('@Url.Action("GetArchivosByTipoInspeccion")', { tipoInspeccionId: tipoInspeccionId }, function (data) {
                        if (data.length > 0) {
                            $.each(data, function (index, item) {
                                var downloadUrl = '@Url.Action("DownloadFile", "Inspecciones", new { fileName = "__fileName__" })'.replace('__fileName__', item.fileName);
                                $listaArchivos.append('<li><a href="' + downloadUrl + '" target="_blank">' + item.fileName + '</a></li>');
                            });
                        } else {
                            $listaArchivos.append('<li>No hay archivos relacionados.</li>');
                        }
                    });
                } else {
                    $listaArchivos.append('<li>Seleccione un tipo de inspección para ver los archivos relacionados.</li>');
                }
            }

            // Cargar archivos cuando se selecciona un tipo de inspección
            $('#TipoInspeccionId').change(function () {
                var tipoInspeccionId = $(this).val();
                cargarArchivos(tipoInspeccionId);
            });
        });



        // Llama a la función cuando cambia el proyecto
        $('#ProyectoId').change(function () {
            var proyectoId = $(this).val();
            cargarInspectores(proyectoId);
        });

        // Cargar inspectores al iniciar la página si ya hay un proyecto seleccionado
        var proyectoInicial = $('#ProyectoId').val();
        if (proyectoInicial) {
            cargarInspectores(proyectoInicial);
        }
    });
</script>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }



}
