@model Buildoc.Models.Inspecciones.InspeccionEditViewModel

@{

    var estadoActual = ViewData["Estado"] != null ? (EstadoInspeccion)ViewData["Estado"] : EstadoInspeccion.Programada;
    var isReadonly = estadoActual == EstadoInspeccion.Desaprobada;
}

<div class="mb-4">
        <form asp-action="Edit" method="post" class="ml-3 mr-3" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
            <input type="hidden" asp-for="Inspeccion.Id" />
        
         <div class="row">
            <div class="col-lg-8">
                <div class="form-group">
                        <label asp-for="Inspeccion.ProyectoId" class="control-label"></label>
                        <select asp-for="Inspeccion.ProyectoId" class="form-control" asp-items="ViewBag.ProyectoId"></select>
                        <span asp-validation-for="Inspeccion.ProyectoId" class="text-danger"></span>
                </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Inspeccion.FechaInspeccion" class="control-label"></label>
                                <div>
                                    @if (isReadonly)
                                    {
                                        <input asp-for="Inspeccion.FechaInspeccion" class="form-control" type="text" readonly />
                                    }
                                    else
                                    {
                                        <input asp-for="Inspeccion.FechaInspeccion" class="form-control" />
                                        <span asp-validation-for="Inspeccion.FechaInspeccion" class="text-danger"></span>
                                    }
                                </div>
                                <span asp-validation-for="Inspeccion.FechaInspeccion" class="text-danger"></span>
                            </div>
                        </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                <label asp-for="Inspeccion.DuracionHoras" class="control-label"></label>
                                <input asp-for="Inspeccion.DuracionHoras" class="form-control" id="DuracionHoras" />
                                <span asp-validation-for="Inspeccion.DuracionHoras" class="text-danger"></span>
                                </div>
                           </div>
                        
                    </div>
                <div class="form-group form-check">
                        <input asp-for="Inspeccion.EsTodoElDia" class="form-check-input" id="EsTodoElDia" />
                        <label asp-for="Inspeccion.EsTodoElDia" class="form-check-label"></label>
                        <span asp-validation-for="Inspeccion.EsTodoElDia" class="text-danger"></span>
                </div>

                <div class="form-group">
                        <label asp-for="Inspeccion.Objetivo" class="control-label"></label>
                        <input asp-for="Inspeccion.Objetivo" class="form-control" />
                        <span asp-validation-for="Inspeccion.Objetivo" class="text-danger"></span>
                </div>

                <div class="form-group">
                        <label asp-for="Inspeccion.Descripcion" class="control-label"></label>
                        <textarea asp-for="Inspeccion.Descripcion" class="form-control"></textarea>
                        <span asp-validation-for="Inspeccion.Descripcion" class="text-danger"></span>
                </div>

                <div class="form-group">
                        <label asp-for="Inspeccion.InspectorId" class="control-label"></label>
                        <select asp-for="Inspeccion.InspectorId" class="form-control" asp-items="ViewBag.InspectorId"></select>
                        <span asp-validation-for="Inspeccion.InspectorId" class="text-danger"></span>
                </div>
                    <!-- Campo para subir archivos -->
                    <div class="form-group">

                    <!-- Archivos de la inspección -->
                    <h6 class="text-primary"><i class="fas fa-file-alt"></i> Archivos adicionales</h6>
                    <ul id="archivosInspeccion" class="list-unstyled">
                        @if (Model.Inspeccion.TipoInspeccion != null && Model.Inspeccion.TipoInspeccion.Archivos != null)
                        {
                            @foreach (var file in Model.Inspeccion.TipoInspeccion.Archivos)
                            {
                                <li><a href="@Url.Action("DownloadFile", "Inspecciones", new { fileName = file.FileName })" target="_blank">@file.FileName</a></li>
                            }
                        }
                        else
                        {
                            <p>No hay archivos disponibles.</p>
                        }

                    </ul>

                    <div class="form-group">
                        <label for="UploadedFiles">Subir Archivos</label>
                        <input type="file" name="UploadedFiles" id="UploadedFiles" multiple />                      
                    </div>
                </div>
            </div>

                <div class="col-lg-4 " >

                <div class="form-group mb-3">
                    <label class="control-label">Categoría de Inspección</label>
                    <select id="CategoriaInspeccion" name="CategoriaInspeccion" class="form-control" asp-items="@(ViewData["CategoriasInspeccion"] as List<SelectListItem>)">
                        <option value="" disabled selected>Seleccionar Categoría</option>
                    </select>
                </div>



                <div class="form-group mb-3">
                        <label asp-for="Inspeccion.TipoInspeccionId" class="control-label"></label>
                        <select asp-for="Inspeccion.TipoInspeccionId" class="form-control" asp-items="ViewBag.TipoInspeccionId" id="TipoInspeccionId">
                     
                    </select>
                </div>

                    <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del tipo de inspección</h6>
                    <p><span style="display: block; font-size: 0.9em;">Descripción</span> <span id="TipoInspeccionDescripcion" class="text-muted"></span></p>

                <!-- Archivos del tipo de inspección -->
                <h6 class="text-primary"><i class="fas fa-file-alt"></i> Archivos plantilla</h6>
                <ul id="archivosTipoInspeccion" class="list-unstyled">
                    @if (Model.Inspeccion.TipoInspeccion != null && Model.Inspeccion.TipoInspeccion.Archivos != null)
                    {
                        @foreach (var file in Model.Inspeccion.TipoInspeccion.Archivos)
                        {
                            <li><a href="@Url.Action("DownloadFile", "Inspecciones", new { fileName = file.FileName })" target="_blank">@file.FileName</a></li>
                        }
                    }
                    else
                    {
                        <p>No hay archivos disponibles.</p>
                    }
                </ul>
                   
                
            </div>
        </div>       
    </form>
</div>


<script src="/js/tamanoArchivos.js"></script>
    <script src="/js/detalleTipoInspeccion.js"></script>
    <script src="/js/toggleDuracionHoras.js"></script>
    <script>
    $(document).ready(function () {
        // Cuando se selecciona una categoría
        $('#CategoriaInspeccion').change(function () {
            var categoria = $(this).val();
            if (categoria) {
                $.getJSON('/Inspecciones/GetTipoInspeccionesPorCategoria', { categoria: categoria }, function (data) {
                    var $tipoInspeccion = $('#TipoInspeccionId');
                    $tipoInspeccion.empty(); // Limpiar el dropdown
                    $.each(data, function (i, tipo) {
                        $tipoInspeccion.append($('<option>', {
                            value: tipo.id,
                            text: tipo.nombre
                        }));
                    });
                });
            }
        });
    });

    </script>