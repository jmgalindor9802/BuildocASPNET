@model IEnumerable<Buildoc.Models.Inspeccion>

@{
    ViewData["Title"] = "Inspecciones";
}

<div class="container-page">
    <div class="row mb-4 align-items-center text-white  p-3" style="background-color:	#24963e;">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="mb-0 ">
                <i class="fas fa-check-circle"></i> Inspecciones aprobadas
            </h1><p class="mb-0">
                <a href="@Url.Action("Index", "Inspecciones")" class="btn btn-light">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            </p>
        </div>
    </div>

    <tr>
        <div class="row mt-3">
            <div class="form-group mb-3 col-4">
                <label class="control-label">Filtrar por proyecto</label>
                <select id="proyecto-filter" class="form-control">
                    <option value="">Todos los proyectos</option>
                    <!-- Las opciones se llenarán dinámicamente con los proyectos -->
                </select>
            </div>
            <div class="form-group mb-3 col-4">
                <label class="control-label">Filtrar por inspector</label>
                <select id="inspector-filter" class="form-control">
                    <option value="">Todos los inspectores</option>
                    <!-- Las opciones se llenarán dinámicamente con los proyectos -->
                </select>
            </div>
            <div class="form-group mb-3 col-4">
                <label class="control-label">Filtrar por tipo de inspección</label>
                <select id="tipo-filter" class="form-control">
                    <option value="">Todos los tipos</option>
                    <!-- Las opciones se llenarán dinámicamente con los proyectos -->
                </select>
            </div>
        </div>
    </tr>

    <table id="example1" class="table table-bordered table-striped">
        <thead class="header-bg">
            <tr>
                <th>@Html.DisplayNameFor(model => model.FechaInspeccion)</th>
                <th>@Html.DisplayNameFor(model => model.TipoInspeccion)</th>
                <th>@Html.DisplayNameFor(model => model.Proyecto)</th>
                <th>@Html.DisplayNameFor(model => model.Inspector)</th>
                <th>@Html.DisplayNameFor(model => model.Estado)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FechaInspeccion)</td>
                    <td>@Html.DisplayFor(modelItem => item.TipoInspeccion.Nombre)</td>
                    <td>@Html.DisplayFor(modelItem => item.Proyecto.Nombre)</td>
                    <td>@Html.DisplayFor(modelItem => item.Inspector.NombreCompleto)</td>
                    <td>
                        <span class="@(item.Estado == EstadoInspeccion.Programada ? "estado-programada-text" : "")">
                            @Html.DisplayFor(modelItem => item.Estado)
                        </span>
                    </td>
                    <td>
                     
                        <a href="#" class="details-view" data-url="@Url.Action("Details", "Inspecciones", new { id = item.Id })" data-title="Detalles de la inspección" data-action="details">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                            </svg>
                        </a>
                   @*      <a href="#" class="delete-item" data-url="@Url.Action("Delete", "Inspecciones", new { id = item.Id })" data-title="Eliminar inspección" data-action="delete">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                            </svg>
                        </a> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <script src="~/js/datatable-config.js"></script>
    <script src="/espanol.js"></script>
    <script>
        $(document).ready(function () {
            // Inicializa la DataTable con la configuración deseada
            let table = $('#example1').DataTable();

            // Función para obtener proyectos únicos del DataTable
            function getProyectos() {
                const proyectos = [];
                table.rows().every(function () {
                    const data = this.data();
                    const proyecto = data[2]; // Asume que la columna de proyecto es la 3ra (índice 2)
                    if (!proyectos.includes(proyecto)) {
                        proyectos.push(proyecto);
                    }
                });
                return proyectos;
            }

            // Función para obtener inspectores únicos del DataTable
            function getInspectores() {
                const inspectores = [];
                table.rows().every(function () {
                    const data = this.data();
                    const inspector = data[3]; // Asume que la columna de proyecto es la 3ra (índice 2)
                    if (!inspectores.includes(inspector)) {
                        inspectores.push(inspector);
                    }
                });
                return inspectores;
            }

            // Función para obtener tipos de inspeccon únicos del DataTable
            function getTipos() {
                const tipos = [];
                table.rows().every(function () {
                    const data = this.data();
                    const tipo = data[1]; // Asume que la columna de proyecto es la 3ra (índice 2)
                    if (!tipos.includes(tipo)) {
                        tipos.push(tipo);
                    }
                });
                return tipos;
            }


            // Llenar el select con las opciones de proyecto
            function fillProyectoSelect() {
                const proyectoFilterEl = $('#proyecto-filter');
                proyectoFilterEl.empty(); // Limpiar el select antes de llenarlo
                proyectoFilterEl.append('<option value="">Todos los proyectos</option>'); // Opción predeterminada
                const proyectos = getProyectos();
                proyectos.forEach(proyecto => {
                    const option = $('<option></option>').val(proyecto).text(proyecto);
                    proyectoFilterEl.append(option);
                });
            }

            // Llenar el select con las opciones de inspectores
            function fillInspectorSelect() {
                const inspectorFilterEl = $('#inspector-filter');
                inspectorFilterEl.empty(); // Limpiar el select antes de llenarlo
                inspectorFilterEl.append('<option value="">Todos los inspectores</option>'); // Opción predeterminada
                const inspectores = getInspectores();
                inspectores.forEach(inspector => {
                    const option = $('<option></option>').val(inspector).text(inspector);
                    inspectorFilterEl.append(option);
                });
            }


            // Llenar el select con las opciones de inspectores
            function fillTipoSelect() {
                const tipoFilterEl = $('#tipo-filter');
                tipoFilterEl.empty(); // Limpiar el select antes de llenarlo
                tipoFilterEl.append('<option value="">Todos los tipos de inspecciones</option>'); // Opción predeterminada
                const tipos = getTipos();
                tipos.forEach(tipo => {
                    const option = $('<option></option>').val(tipo).text(tipo);
                    tipoFilterEl.append(option);
                });
            }

            // Inicializa el select con proyectos
            fillProyectoSelect();

            // Inicializa el select con inspectores
            fillInspectorSelect();

            // Inicializa el select con tipos
            fillTipoSelect();

            // Agregar evento de cambio al select para filtrar la tabla
            $('#proyecto-filter').on('change', function () {
                const proyectoFilter = $(this).val();
                table.column(2).search(proyectoFilter).draw(); // Filtra la columna de proyectos
            });

            // Agregar evento de cambio al select para filtrar la tabla
            $('#inspector-filter').on('change', function () {
                const inspectorFilter = $(this).val();
                table.column(3).search(inspectorFilter).draw(); // Filtra la columna de proyectos
            });

            // Agregar evento de cambio al select para filtrar la tabla
            $('#tipo-filter').on('change', function () {
                const tipoFilter = $(this).val();
                table.column(1).search(tipoFilter).draw(); // Filtra la columna de proyectos
            });

            // Agregar función de búsqueda personalizada si es necesario
            $.fn.dataTable.ext.search.push(
                function (settings, data, dataIndex) {
                    const proyectoFilter = $('#proyecto-filter').val();
                    const proyecto = data[2]; // Asume que la columna de proyecto es la 3ra (índice 2)
                    return proyectoFilter === "" || proyecto === proyectoFilter;
                }
            );


        });


    </script>

<style>
    .estado-programada-text {
        color: blue;
    }
</style>

