@model Buildoc.Models.Incidente

@{
    Layout = null;
}

<div class="row">
    <!-- Columna Derecha (Datos del Proyecto) -->
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del proyecto</h6>
                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Nombre)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Departamento)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Departamento)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Municipio)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Municipio)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Direccion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Direccion)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Cliente)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Cliente)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Descripcion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Descripcion)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Línea de Tiempo Combinada -->
<div class="row mt-3">
    <div class="col-md-12">
        <div class="card">
            <h6 class="text-primary"><i class="fas fa-history"></i> Línea de Tiempo</h6>
            <div class="timeline">
                <!-- Evento de incidente -->
                <div class="timeline-item">
                    <i class="fas fa-exclamation-triangle bg-danger"></i>
                    <div class="timeline-item">
                        <span class="time"><i class="fas fa-clock"></i> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                        <h3 class="timeline-header">Incidente reportado</h3>
                        <div class="timeline-body">
                            <p><strong>Tipo de incidente:</strong> @Model.TipoIncidente.Titulo</p>
                            <p><strong>Incidente:</strong> @Model.Titulo</p>
                            <p><strong>Descripcion:</strong> @Model.Descripcion</p>
                            <p><strong>Sugerencia:</strong> @(string.IsNullOrEmpty(Model.Sugerencia) ? "No hay sugerencia" : Model.Sugerencia)</p>
                            <p><strong>Autor del reporte:</strong> @Model.Usuario.NombreCompleto
                                <small>(@Html.DisplayFor(model => model.Usuario.Email))</small>
                            </p>
                            <p>
                                <strong>Estado actual:</strong>
                                <span class="badge @(Model.Estado == EstadoIncidenteEnum.Activo ? "badge-programada" :
                                              Model.Estado == EstadoIncidenteEnum.Vencido ? "badge-pendiente-revision" :
                                              Model.Estado == EstadoIncidenteEnum.Solucionado ? "badge-sin-responder" :
                                              Model.Estado == EstadoIncidenteEnum.Cerrado ? "badge-aprobada" : "")">
                                    @Html.DisplayFor(model => model.Estado)
                                </span>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Novedades -->
                @if (Model.NovedadesIncidentes != null && Model.NovedadesIncidentes.Any())
                {


                    @foreach (var novedad in Model.NovedadesIncidentes.OrderBy(n => n.FechaCreacion))
                    {
                        <div class="timeline-item">
                            <i class="fas fa-info-circle bg-yellow"></i>
                            <div class="timeline-item">
                                <span class="time"><i class="fas fa-clock"></i> @novedad.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                                <h3 class="timeline-header">Novedad</h3>
                                <div class="timeline-body">
                                    <p>@novedad.Titulo</p>
                                    <p>@novedad.Descripcion</p>
                                    <p><strong>Autor:</strong> @novedad.Usuario.NombreCompleto</p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="timeline-item">
                        <i class="fas fa-info-circle bg-gray"></i>
                        <div class="timeline-item">
                            <span class="time"><i class="fas fa-clock"></i> No disponible</span>
                            <h3 class="timeline-header">Novedades</h3>
                            <div class="timeline-body">
                                <p>No hay novedades relacionadas con esta inspección.</p>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>