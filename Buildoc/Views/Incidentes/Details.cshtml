@model Buildoc.Models.Incidente

@{
    Layout = null;
}

<div class="row">
    <!-- Columna Derecha (Datos del Proyecto) -->
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del proyecto</h6>
                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Nombre)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Departamento)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Departamento)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Municipio)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Municipio)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Direccion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Direccion)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Cliente)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Cliente)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Proyecto.Descripcion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Proyecto.Descripcion)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Línea de Tiempo Combinada -->
<div class="row mt-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-history"></i> Línea de Tiempo</h6>
                <div class="timeline">
                    <!-- Evento de incidente -->
                    <div class="timeline-item">
                        <i class="fas fa-exclamation-triangle bg-danger"></i>
                        <div class="timeline-item">
                            <span class="time"><i class="fas fa-clock"></i> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                            <h3 class="timeline-header">Incidente reportado</h3>
                            <div class="timeline-body">
                                <p><strong>Tipo de incidente:</strong> @Model.TipoIncidente.Titulo</p>
                                <p><strong>Incidente:</strong> @Model.Titulo</p>
                                <p><strong>Descripcion:</strong> @Model.Descripcion</p>
                                <p><strong>Sugerencia:</strong> @(string.IsNullOrEmpty(Model.Sugerencia) ? "No hay sugerencia" : Model.Sugerencia)</p>
                                <p>
                                    <strong>Autor del reporte:</strong> @Model.Usuario.NombreCompleto
                                    <small>(@Html.DisplayFor(model => model.Usuario.Email))</small>
                                </p>
                                <p>
                                    <strong>Estado actual:</strong>
                                    <span class="badge @(Model.Estado == EstadoIncidenteEnum.Activo ? "badge-sin-responder" :
                                              Model.Estado == EstadoIncidenteEnum.Vencido ? "badge-programada" :
                                              Model.Estado == EstadoIncidenteEnum.Solucionado ? "badge-aprobada" :
                                              Model.Estado == EstadoIncidenteEnum.Cerrado ? "badge-cerrado" : "")">
                                        @Html.DisplayFor(model => model.Estado)
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <!-- Lesionados relacionados al incidente -->
                    @if (Model.IncidenteLesionados != null && Model.IncidenteLesionados.Any())
                    {
                        @foreach (var incidenteLesionado in Model.IncidenteLesionados)
                        {
                            <div class="timeline-item">
                                <i class="fas fa-user-injured bg-warning"></i>
                                <div class="timeline-item">
                                    <span class="time"><i class="fas fa-clock"></i> @incidenteLesionado.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                                    <h3 class="timeline-header">Lesionado reportado</h3>
                                    <div class="timeline-body">
                                        <p><strong>Nombre:</strong> @incidenteLesionado.Lesionado.Nombre @incidenteLesionado.Lesionado.Apellido</p>
                                        <p><strong>Cédula:</strong> @incidenteLesionado.Lesionado.Cedula</p>
                                        <p><strong>Correo electrónico:</strong> @(string.IsNullOrEmpty(incidenteLesionado.Lesionado.CorreoElectronico) ? "No disponible" : incidenteLesionado.Lesionado.CorreoElectronico)</p>
                                        <p><strong>Defunción:</strong> @(incidenteLesionado.Defuncion ? "Sí" : "No")</p>
                                        <p><strong>Actividad realizada:</strong> @(string.IsNullOrEmpty(incidenteLesionado.ActividadRealizada) ? "No especificada" : incidenteLesionado.ActividadRealizada)</p>
                                        <p><strong>Género:</strong> @incidenteLesionado.GeneroAfectado</p>
                                        <p><strong>Hospitalización:</strong> @(incidenteLesionado.Hospitalizado ? "Sí" : "No")</p>
                                        <p><strong>Primeros Auxilios:</strong> @(incidenteLesionado.PrimerosAuxilios ? "Sí" : "No")</p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="timeline-item">
                            <i class="fas fa-user-injured bg-gray"></i>
                            <div class="timeline-item">
                                <span class="time"><i class="fas fa-clock"></i> No disponible</span>
                                <h3 class="timeline-header">Lesionados</h3>
                                <div class="timeline-body">
                                    <p>No hay lesionados relacionados con este incidente.</p>
                                </div>
                            </div>
                        </div>
                    }
                    <!-- Novedades -->
                    @if (Model.NovedadesIncidentes != null && Model.NovedadesIncidentes.Any())
                    {
                        @foreach (var novedad in Model.NovedadesIncidentes.OrderBy(n => n.FechaCreacion))
                        {
                            <div class="timeline-item">
                                <i class="fas fa-info-circle bg-yellow"></i>
                                <div class="timeline-item">
                                    <span class="time"><i class="fas fa-clock"></i> @novedad.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                                    <h3 class="timeline-header">Novedad</h3>
                                    <div class="timeline-body">
                                        <p>@novedad.Titulo</p>
                                        <p>@novedad.Descripcion</p>
                                        <span class="badge @(novedad.EstadoNovedad == EstadoIncidenteEnum.Activo ? "badge-sin-responder" :
                                              novedad.EstadoNovedad == EstadoIncidenteEnum.Vencido ? "badge-programada" :
                                              novedad.EstadoNovedad == EstadoIncidenteEnum.Solucionado ? "badge-aprobada" :
                                              novedad.EstadoNovedad == EstadoIncidenteEnum.Cerrado ? "badge-cerrado" : "")">
                                            @novedad.EstadoNovedad
                                        </span>
                                        <p><strong>Autor:</strong> @novedad.Usuario.NombreCompleto</p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="timeline-item">
                            <i class="fas fa-info-circle bg-gray"></i>
                            <div class="timeline-item">
                                <span class="time"><i class="fas fa-clock"></i> No disponible</span>
                                <h3 class="timeline-header">Novedades</h3>
                                <div class="timeline-body">
                                    <p>No hay novedades relacionadas con esta inspección.</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (Model.Estado == EstadoIncidenteEnum.Activo)
                {
                    <button type="button" class="btn btn-primary respond-item"
                            data-url="@Url.Action("Create", "NovedadesIncidentes", new { incidenteId = Model.Id })"
                            data-title="Agregar Novedad"
                            data-action="respond">
                        <i class="fas fa-plus-circle"></i> Añadir Novedad
                    </button>
                    <button type="button" class="btn btn-primary respond-item"
                            data-url="@Url.Action("Create", "Lesionadoes", new { incidenteId = Model.Id })"
                            data-title="Agregar Novedad"
                            data-action="respond">
                        <i class="fas fa-plus-circle"></i> Añadir Lesionados
                    </button>
                }
            </div>
        </div>
    </div>
</div>