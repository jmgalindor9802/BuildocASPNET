@model IncidenteViewModel

@{

}
<div class="row justify-content-center mb-4">
    <div class="col-md-12">
        <form asp-action="Create" class="ml-3 mr-3" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="bs-stepper">
                <!-- Encabezado del formulario paso a paso --> 
                <div class="bs-stepper-header" role="tablist">
                    <div class="step" data-target="#incidente-part">
                        <button type="button" class="step-trigger" role="tab" aria-controls="incidente-part" id="incidente-part-trigger">
                            <span class="bs-stepper-circle">1</span>
                            <span class="bs-stepper-label">Detalles del Incidente</span>
                        </button>
                    </div>
                    <div class="line"></div>
                    <div class="step" data-target="#afectados-part">
                        <button type="button" class="step-trigger" role="tab" aria-controls="afectados-part" id="afectados-part-trigger">
                            <span class="bs-stepper-circle">2</span>
                            <span class="bs-stepper-label">Lesionados</span>
                        </button>
                    </div>
                </div>
                <!--Cuerpo del formulario paso a paso-->
                <div class="bs-stepper-content">
                <!-- Step 1: Detalles del Incidente -->
                    <div id="incidente-part" class="content" role="tabpanel" aria-labelledby="incidente-part-trigger">
                        <div class="row">
                            <div class="col-lg-8">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Incidente.Titulo" class="control-label"></label>
                                            <input asp-for="Incidente.Titulo" class="form-control" />
                                            <span asp-validation-for="Incidente.Titulo" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Incidente.ProyectoId" class="control-label"></label>
                                            <select asp-for="Incidente.ProyectoId" class="form-control" asp-items="ViewBag.ProyectoId"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Incidente.FechaIncidente" class="control-label"></label>
                                            <input asp-for="Incidente.FechaIncidente" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                            <span asp-validation-for="Incidente.FechaIncidente" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Incidente.HoraIncidente" class="control-label"></label>
                                            <input asp-for="Incidente.HoraIncidente" type="time" class="form-control" id="horaIncidente" />
                                            <span asp-validation-for="Incidente.HoraIncidente" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class=col-md-6></div>
                                    <div class=col-md-6>
                                        @* checkbox para ocultar la hora *@
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" value="" id="desconoceHora">
                                            <label class="form-check-label" for="desconoceHora">¿Se desconoce la hora?</label>
                                        </div>
                                        @* checkbox para ocultar la hora *@
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Incidente.Descripcion" class="control-label"></label>
                                    <p>
                                        Describa detalladamente el incidente, sus causas, e identifique los objetos o sustancias involucrados.
                                    </p>
                                    <textarea asp-for="Incidente.Descripcion" class="form-control" rows="3"></textarea>
                                    <span asp-validation-for="Incidente.Descripcion" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Incidente.Sugerencia" class="control-label"></label>
                                    <textarea asp-for="Incidente.Sugerencia" class="form-control"></textarea>
                                    <span asp-validation-for="Incidente.Sugerencia" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label for="UploadedFiles">Subir Archivos</label>
                                    <input type="file" name="UploadedFiles" id="UploadedFiles" multiple />
                                </div>
                                @* switch para mostrar los campos de afectados *@
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="SwitchAfectados" name="switchAfectados" value="true">
                                    <label class="form-check-label" for="SwitchAfectados">¿Existen lesionados?</label>
                                </div>
                                <div class="row">
                                    <!-- Botón para ir al siguiente paso -->
                                    <button type="button" class="btn btn-primary btn-next" id="btnNext" style="display: none;">Siguiente</button>
                                </div>
                            </div>
                            @* ./switch para mostrar los campos de afectados *@
                            <div class="col-lg-4 order-1 order-md-2">
                                <div class="form-group mb-3">
                                    <label class="control-label">Categoria del tipo de incidente</label>
                                    <select class="form-control" id="CategoriaTipoIncidente" name="CategoriaTipoIncidente">
                                        @foreach (var categoria in ViewBag.CategoriaTipoIncidente as List<SelectListItem>)
                                        {
                                            <option value="@categoria.Value">@categoria.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Incidente.TipoIncidenteId" class="control-label"></label>
                                    <select asp-for="Incidente.TipoIncidenteId" class="form-control" asp-items="ViewBag.TipoIncidenteId" id="tipoIncidenteSelect">
                                        <option value="">Seleccione un tipo de incidente</option>
                                    </select>
                                </div>

                                @* Campos para mostrar la informacion del tipo de incidente *@
                                <div class="card">
                                    <div class="card-header">
                                        <h6 class="text-primary mb-0"><i class="fas fa-info-circle"></i> Detalles del tipo de incidente</h6>
                                    </div>
                                    <div class="card-body">
                                        <p><span style="display: block; font-size: 0.9em;">Categoria</span> <span id="TipoIncidenteCategoria" class="text-muted"></span></p>
                                        <p><span style="display: block; font-size: 0.9em;">Nombre</span> <span id="TipoIncidenteTitulo" class="text-muted"></span></p>
                                        <p><span style="display: block; font-size: 0.9em;">Gravedad</span> <span id="TipoIncidenteGravedad" class="text-muted"></span></p>
                                        <p><span style="display: block; font-size: 0.9em;">Descripción</span> <span id="TipoInspeccionDescripcion" class="text-muted"></span></p>
                                    </div>
                                </div>
                                @* ./Fin Campos para mostrar la informacion del tipo de incidente *@
                            </div>
                            
                        </div>
                    </div>
                    <!-- Step 2: Detalles de los lesionados -->
                    <div id="afectados-part" class="content" role="tabpanel" aria-labelledby="afectados-part-trigger">
                        <div id="lesionados-container">
                            <div class="lesionado-item">
                                <h5>Lesionados</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Lesionados[0].Cedula" class="control-label"></label>
                                            <input asp-for="Lesionados[0].Cedula" type="number" class="form-control" />
                                            <span asp-validation-for="Lesionados[0].Cedula" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Lesionados[0].CorreoElectronico" class="control-label"></label>
                                            <input asp-for="Lesionados[0].CorreoElectronico" type="email" class="form-control" />
                                            <span asp-validation-for="Lesionados[0].CorreoElectronico" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Lesionados[0].Nombre" class="control-label"></label>
                                            <input asp-for="Lesionados[0].Nombre" class="form-control" />
                                            <span asp-validation-for="Lesionados[0].Nombre" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Lesionados[0].Apellido" class="control-label"></label>
                                            <input asp-for="Lesionados[0].Apellido" class="form-control" />
                                            <span asp-validation-for="Lesionados[0].Apellido" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label asp-for="IncidenteLesionados[0].GeneroAfectado" class="control-label"></label>
                                            <select asp-for="IncidenteLesionados[0].GeneroAfectado" class="form-control">
                                                <option value="Hombre">Hombre</option>
                                                <option value="Mujer">Mujer</option>
                                            </select>
                                            <span asp-validation-for="IncidenteLesionados[0].GeneroAfectado" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="control-label">¿El afectado esta muerto?</label>
                                            <select asp-for="IncidenteLesionados[0].Defuncion" class="form-control">
                                                <option value="false">No</option>
                                                <option value="true">Sí</option>
                                            </select>
                                            <span asp-validation-for="IncidenteLesionados[0].Defuncion" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="control-label">¿El afectado es un trabajador?</label>
                                            <select asp-for="IncidenteLesionados[0].AsociadaProyecto" class="form-control">
                                                <option value="false">No</option>
                                                <option value="true">Sí</option>
                                            </select>
                                            <span asp-validation-for="IncidenteLesionados[0].AsociadaProyecto" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="control-label">¿Se brindaron primeros auxilios?</label>
                                            <select asp-for="IncidenteLesionados[0].PrimerosAuxilios" class="form-control">
                                                <option value="false">No</option>
                                                <option value="true">Sí</option>
                                            </select>
                                            <span asp-validation-for="IncidenteLesionados[0].PrimerosAuxilios" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="control-label">¿Tuvieron que hospitalizar al lesionado?</label>
                                            <select asp-for="IncidenteLesionados[0].Hospitalizado" class="form-control">
                                                <option value="false">No</option>
                                                <option value="true">Sí</option>
                                            </select>
                                            <span asp-validation-for="IncidenteLesionados[0].Hospitalizado" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label class="control-label">Descripción de la actividad realizada durante el incidente</label>
                                            <textarea asp-for="IncidenteLesionados[0].ActividadRealizada" class="form-control"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-danger remove-lesionado">Eliminar lesionado</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex mt-3">
                            <button type="button" id="add-lesionado" class="btn btn-success mr-4"><i class="fas fa-plus-circle"></i> Añadir lesionado</button>
                            <button type="button" class="btn btn-primary btn-previous">Anterior</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="/js/scriptincidentecreate.js"></script>
<script src="/js/afectados.js"></script>
<script>
    $(document).ready(function () {
        $('#tuFormulario').on('submit', function (e) {
            // Crear un array para almacenar las cédulas
            let cedulas = [];
            let cedulaDuplicada = false;

            // Recorrer todos los campos de cédula en el formulario
            $('.cedula').each(function () {
                let cedula = $(this).val();

                // Verificar si la cédula ya está en el array
                if (cedulas.includes(cedula)) {
                    cedulaDuplicada = true;
                    return false; // Rompe el bucle si encuentra una cédula duplicada
                }

                // Añadir la cédula al array
                cedulas.push(cedula);
            });

            // Si hay una cédula duplicada, mostrar el mensaje y evitar el envío del formulario
            if (cedulaDuplicada) {
                e.preventDefault(); // Evitar que se envíe el formulario
                return Json(new { success = false, message = "Hay cédulas duplicadas en el formulario." });
            }
        });
    });
</script>