@model IEnumerable<Buildoc.Models.Incidente>

@{
    ViewData["Title"] = "Index";
    var esCoordinador = User.IsInRole("Coordinador");
    var esAdministrador = User.IsInRole("Administrador");
    var esResidente = User.IsInRole("Residente");
}
<style>
    /* Estilos para desactivar el color azul y el subrayado en a */
    a {
        text-decoration: none; /* Elimina el subrayado */
        cursor: pointer; /* Cambia el cursor al estilo de un botón */
    }

    .disabled {
        pointer-events: none;
        opacity: 0.5;
    }

    .map-container {
        position: relative;
        height: 100%;
        min-height: 400px;
    }

    .charts-container {
        padding: 15px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        margin-bottom: 20px;
    }
</style>

<div class="container-page">
    <div class="row mb-4 align-items-center text-white p-3" style="background-color: #001f3f;">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="mb-0"><i class="fas fa-exclamation-triangle "></i> Incidentes</h1>
            @if (esCoordinador || esResidente)
            {
                <p class="mb-0">
                    <a href="#" id="createNewModal" class="create-new btn btn-light"
                       data-url="@Url.Action("Create", "Incidentes")"
                       data-title="Reportar incidente" data-action="create">
                        <i class="fas fa-plus"></i>
                        <span class="d-none d-md-inline">Reportar incidente</span>
                    </a>
                </p>
            }
            else if (esAdministrador)
            {
                <p class="mb-0">
                    <a asp-controller="TipoIncidentes" asp-action="Index" class="btn btn-light">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-card-checklist" viewBox="0 0 16 16">
                            <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z" />
                            <path d="M7 5.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0M7 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0" />
                        </svg> Tipos de incidente
                    </a>
                </p>
            }
        </div>
    </div>

    <div class="row">
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>@ViewBag.ActivosIncidentes</h3>

                    <p>Activos</p>
                </div>
                <div class="icon">
                    <i class="fas fa-exclamation-triangle" style="font-size:55px;"></i>
                </div>
                <a asp-action="IncidenteActivos" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>@ViewBag.CerradosIncidentes</h3>
                    <p>Cerrados</p>
                </div>
                <div class="icon">
                    <i class="fas fa-lock" style="font-size:55px;"></i>
                </div>
                <a asp-action="IncidenteCerrados" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@ViewBag.ArchivadosIncidentes</h3>

                    <p>Resueltos</p>
                </div>
                <div class="icon">
                    <i class="fas fa-check-circle" style="font-size:55px;"></i>
                </div>
                <a asp-action="IncidenteArchivados" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-olive">
                <div class="inner">
                    <h3>@ViewBag.TotalLesionados</h3>

                    <p>Lesionados</p>
                </div>
                <div class="icon">
                    <i class="fas fa-medkit" style="font-size:55px;"></i>
                </div>
                <a asp-controller="Lesionadoes" asp-action="Index" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
    </div>

    @* Diagramas *@
    <div class="row">
        <!-- Columna izquierda: Gráficas -->
        <div class="col-lg-6 col-md-12 col-12">
            <div class="row">
                <!-- Primera gráfica torta de incidentes por proyecto -->
                <div class="col-md-6 col-sm-12">
                    <div class="charts-container">
                        <h5>Incidentes activos</h5>
                        <canvas id="inspectionPieChart" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica más pequeña -->
                    </div>
                </div>
                <div class="col-md-6 col-sm-12">
                    <div class="charts-container">
                        <h5>Incidentes activos por fecha</h5>
                        <canvas id="incidenteLineChart" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica más pequeña -->
                    </div>
                </div>
            </div>
            <!-- Tercera gráfica torta de incidentes por tipo de incidente -->
            <div class="col-md-6 col-sm-12">
                <div class="charts-container">
                    <h5>Por tipos de Incidentes</h5>
                    <canvas id="tipoInspeccionPieChart" style="width: 200px; height: 200px;"></canvas> <!-- Gráfica más pequeña -->
                </div>
            </div>
        </div>

        @*Mapa columna derecha*@
        <!-- Columna con el mapa de Colombia -->
        <div class="col-lg-6 col-md-12 col-12 d-flex flex-column">
            <div class="map-container">
                <!-- Contenedor para los controles del mapa -->
                <div id="map-controls" class="position-absolute" style="top: 10px; left: 10px; z-index: 1000;">
                    <button id="zoom-in" class="btn btn-light" title="Acercar" style="margin-bottom: 5px;">
                        <i class="fas fa-search-plus"></i>
                    </button>
                    <button id="zoom-out" class="btn btn-light" title="Alejar" style="margin-bottom: 5px;">
                        <i class="fas fa-search-minus"></i>
                    </button>
                    <button id="zoom-reset" class="btn btn-light" title="Restablecer zoom">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <!-- Filtro para inspecciones dentro del mapa -->
                <div id="map-filter" class="position-absolute p-2 bg-white border rounded" style="top: 10px; right: 10px; z-index: 1000;">
                    <div id="map-filter" class="position-absolute p-2 bg-white border rounded" style="top: 10px; right: 10px; z-index: 1000;">
                        <label for="filterIncidente" class="form-label">Filtrar por estado:</label>
                        <select id="filterIncidente" class="form-control">
                            <option value="all">Todos</option>
                            <option value="0">Activos</option>
                            <option value="1">Cerrados</option>
                            <option value="2">Resueltos</option>
                        </select>
                    </div>
                </div>
                <!-- Mapa -->
                <div id="map"></div>
            </div>
        </div>
    </div>

    <tr>
        <div class="row mt-3">
            <div class="form-group mb-3 col-6">
                <label class="control-label">Filtrar por proyecto</label>
                <select id="proyecto-filter" class="form-control">
                    <option value="">Todos los proyectos</option>
                    <!-- Las opciones se llenarán dinámicamente -->
                </select>
            </div>
            <div class="form-group mb-3 col-6">
                <label class="control-label">Filtrar por tipo de incidente</label>
                <select id="tipo-incidente-filter" class="form-control">
                    <option value="">Todos los tipos de incidentes</option>
                    <!-- Las opciones se llenarán dinámicamente -->
                </select>
            </div>
        </div>
    </tr>
    <table id="example1" class="table table-bordered table-striped">
        <thead class="header-bg">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Titulo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FechaIncidente)
                </th>
                <th>
                    Proyecto Asociado
                </th>
                <th>
                    Tipo de Incidente
                </th>
                <th>
                    Estado Actual
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-proyecto="@item.Proyecto.Id" data-tipo-incidente="@item.TipoIncidente.Id">
                    <td>
                        @Html.DisplayFor(modelItem => item.Titulo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FechaIncidente)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Proyecto.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TipoIncidente.Titulo)
                    </td>
                    <td>
                        <span class="badge @(item.Estado == EstadoIncidenteEnum.Activo ? "badge-sin-responder" :
                                              item.Estado == EstadoIncidenteEnum.Vencido ? "badge-programada" :
                                              item.Estado == EstadoIncidenteEnum.Solucionado ? "badge-aprobada" :
                                              item.Estado == EstadoIncidenteEnum.Cerrado ? "badge-cerrado" : "")">
                            @Html.DisplayFor(modelItem => item.Estado)
                        </span>
                    </td>
                    <td>
                        <a href="#" class="edit-item" data-url="@Url.Action("Details", "Incidentes", new { id = item.Id })" data-title="Detalles del incidente" data-action="details">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                            </svg>
                        </a>
                        @if (item.Estado == EstadoIncidenteEnum.Activo)
                        {
                            if (esCoordinador || esResidente)
                            {
                                <a href="#" type="button" class="respond-item"
                                   data-url="@Url.Action("Create", "NovedadesIncidentes", new { incidenteId = item.Id })"
                                   data-title="Agregar Novedad"
                                   data-action="respond">
                                    <i class="fas fa-plus-circle"></i>
                                </a>
                                <a href="#" type="button" class="respond-item"
                                   data-url="@Url.Action("Create", "Lesionadoes", new { incidenteId = item.Id })"
                                   data-title="Agregar Novedad"
                                   data-action="respond">
                                    <i class="fas fa-user-injured"></i>
                                </a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    var municipiosConIncidentes = ViewBag.MunicipiosConIncidentes as List<string>;
}
<script src="\js\inicializacionyfiltrotableincidente.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Asegurarse de que inspeccionesPorProyecto no esté indefinido o sea nulo
    var incidentesPorProyecto = @Html.Raw(Json.Serialize(ViewBag.IncidentesPorProyecto)) || [];

    // Verificar si el array tiene datos
    if (incidentesPorProyecto.length === 0) {
        console.warn("No hay datos para generar la gráfica, se mostrará un gráfico vacío.");

        // Crear el gráfico de torta vacío
        var ctx = document.getElementById('inspectionPieChart').getContext('2d');
        var inspectionPieChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: ["Sin datos"], // Etiqueta para gráfico vacío
                datasets: [{
                    label: 'Número de Inspecciones Programadas',
                    data: [1], // Valor ficticio para que la gráfica se muestre
                    backgroundColor: ['rgba(200, 200, 200, 0.5)'], // Color gris claro
                    borderColor: ['rgba(150, 150, 150, 1)'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                        align: 'left',  // Alinea la leyenda al inicio (izquierda)
                    },
                    tooltip: {
                        enabled: false // No tooltips para gráfico vacío
                    }
                }
            }
        });
    } else {
        // Si hay datos, generar la gráfica con los proyectos y cantidades reales
        var proyectos = incidentesPorProyecto.map(function (item) { return item.proyecto; });
        var cantidades = incidentesPorProyecto.map(function (item) { return item.cantidad; });

        var ctx = document.getElementById('inspectionPieChart').getContext('2d');
        var inspectionPieChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: proyectos, // Los nombres de los proyectos
                datasets: [{
                    label: 'Número de Incidentes Activos',
                    data: cantidades, // Cantidades de inspecciones por proyecto
                    backgroundColor: [
                        'rgba(255, 69, 58, 0.7)',    // Rojo fuerte
                        'rgba(255, 99, 132, 0.7)',   // Rojo claro
                        'rgba(255, 159, 64, 0.7)',   // Naranja fuerte
                        'rgba(255, 205, 86, 0.7)',   // Amarillo
                        'rgba(255, 140, 0, 0.7)',    // Naranja oscuro
                        'rgba(220, 20, 60, 0.7)'     // Carmesí
                    ],
                    borderColor: [
                        'rgba(255, 69, 58, 1)',      // Rojo fuerte
                        'rgba(255, 99, 132, 1)',     // Rojo claro
                        'rgba(255, 159, 64, 1)',     // Naranja fuerte
                        'rgba(255, 205, 86, 1)',     // Amarillo
                        'rgba(255, 140, 0, 1)',      // Naranja oscuro
                        'rgba(220, 20, 60, 1)'       // Carmesí
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',

                        align: 'start',  // Alinea la leyenda al inicio (izquierda)
                    },
                    tooltip: {
                        enabled: true
                    }
                }
            }
        });
    }
</script>
<script>
    var incidentesPorFecha = @Html.Raw(Json.Serialize(ViewBag.IncidentesPorFecha)) || [];
    console.log("incidentesPorFecha", incidentesPorFecha);

    if (incidentesPorFecha.length === 0) {
        console.log("No hay datos para generar la gráfica, se mostrará un gráfico vacío.");

        var ctx = document.getElementById('incidenteLineChart').getContext('2d');
        var incidenteLineChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ["Sin datos"],
                datasets: [{
                    label: 'Número de Incidentes',
                    data: [0],
                    fill: false,
                    borderColor: 'rgba(200, 200, 200, 1)',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: { title: { display: true, text: 'Fecha' } },
                    y: { title: { display: true, text: 'Cantidad de Incidentes' }, beginAtZero: true }
                }
            }
        });
    } else {
        console.log("Ingreso a los datos del incidente");

        // Agrupar por proyecto y fecha
        var incidentesAgrupados = {};

        incidentesPorFecha.forEach(item => {
            const clave = item.proyecto + '-' + item.fecha; // Crear una clave única por proyecto y fecha
            if (!incidentesAgrupados[clave]) {
                incidentesAgrupados[clave] = {
                    proyecto: item.proyecto,
                    fecha: item.fecha,
                    cantidad: item.cantidad
                };
            } else {
                incidentesAgrupados[clave].cantidad += item.cantidad; // Sumar cantidades si ya existe
            }
        });

        // Preparar datos para la gráfica
        var datasets = [];
        var proyectos = [...new Set(Object.values(incidentesAgrupados).map(item => item.proyecto))]; // Obtener proyectos únicos
        var fechas = [...new Set(Object.values(incidentesAgrupados).map(item => item.fecha))]; // Obtener fechas únicas

        proyectos.forEach(proyecto => {
            var data = new Array(fechas.length).fill(0); // Inicializar con ceros
            fechas.forEach((fecha, index) => {
                var clave = proyecto + '-' + fecha;
                if (incidentesAgrupados[clave]) {
                    data[index] = incidentesAgrupados[clave].cantidad;
                }
            });

            datasets.push({
                label: proyecto,
                data: data,
                fill: false,
                borderColor: getRandomColor(),
                tension: 0.1
            });
        });

        // Crear la gráfica
        var ctx = document.getElementById('incidenteLineChart').getContext('2d');
        var incidenteLineChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: fechas,
                datasets: datasets
            },
            options: {
                responsive: true,
                scales: {
                    x: { title: { display: true, text: 'Fecha' } },
                    y: { title: { display: true, text: 'Cantidad de Incidentes' }, beginAtZero: true }
                }
            }
        });
    }

    function getRandomColor() {
        var letters = '0123456789ABCDEF';
        var color = '#';
        for (var i = 0; i < 6; i++) {
            color += letters[Math.floor(Math.random() * 16)];
        }
        return color;
    }
</script>


