@model IEnumerable<Buildoc.Models.Incidente>

@{
    ViewData["Title"] = "Index";
    var esCoordinador = User.IsInRole("Coordinador");
    var esAdministrador = User.IsInRole("Administrador");
    var esResidente = User.IsInRole("Residente");
}
<style>
    /* Estilos para desactivar el color azul y el subrayado en a */
    a {
        text-decoration: none; /* Elimina el subrayado */
        cursor: pointer; /* Cambia el cursor al estilo de un botón */
    }
</style>

<div class="container-page">
    <div class="row mb-4 align-items-center text-white p-3" style="background-color: #001f3f;">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="mb-0"><i class="fas fa-exclamation-triangle "></i> Incidentes</h1>
            @if (esCoordinador || esResidente)
            {
                <p class="mb-0">
                    <a href="#" id="createNewModal" class="create-new btn btn-light"
                       data-url="@Url.Action("Create", "Incidentes")"
                       data-title="Reportar incidente" data-action="create">
                        <i class="fas fa-plus"></i>
                        <span class="d-none d-md-inline">Reportar incidente</span>
                    </a>
                </p>
            }
            else if (esAdministrador)
            {
                <p class="mb-0">
                    <a asp-controller="TipoIncidentes" asp-action="Index" class="btn btn-light">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-card-checklist" viewBox="0 0 16 16">
                            <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z" />
                            <path d="M7 5.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0M7 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0" />
                        </svg> Tipos de incidente
                    </a>
                </p>
            }
        </div>
    </div>

    <div class="row">
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>@ViewBag.ActivosIncidentes</h3>

                    <p>Activos</p>
                </div>
                <div class="icon">
                    <i class="fas fa-exclamation-triangle" style="font-size:55px;"></i>
                </div>
                <a asp-action="IncidenteActivos" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>@ViewBag.CerradosIncidentes</h3>
                    <p>Cerrados</p>
                </div>
                <div class="icon">
                    <i class="fas fa-lock" style="font-size:55px;"></i>
                </div>
                <a asp-action="IncidenteCerrados" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@ViewBag.ArchivadosIncidentes</h3>

                    <p>Resueltos</p>
                </div>
                <div class="icon">
                    <i class="fas fa-check-circle" style="font-size:55px;"></i>
                </div>
                <a asp-action="IncidenteArchivados" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
        <div class="col mb-1">
            <!-- small card -->
            <div class="small-box bg-olive">
                <div class="inner">
                    <h3>@ViewBag.TotalLesionados</h3>

                    <p>Lesionados</p>
                </div>
                <div class="icon">
                    <i class="fas fa-medkit" style="font-size:55px;"></i>
                </div>
                <a asp-controller="Lesionadoes" asp-action="Index" class="small-box-footer">
                    Ver <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
    </div>

    @*Mapa*@
    <div class="row">
        <!-- Columna con el mapa de Colombia -->
        <div class="col-lg-12 col-md-8 col-12 d-flex flex-column">
            <div class="map-container">
                <!-- Contenedor para los controles del mapa -->
                <div id="map-controls" class="position-absolute" style="top: 10px; left: 10px; z-index: 1000;">
                    <button id="zoom-in" class="btn btn-light" title="Acercar" style="margin-bottom: 5px;">
                        <i class="fas fa-search-plus"></i>
                    </button>
                    <button id="zoom-out" class="btn btn-light" title="Alejar" style="margin-bottom: 5px;">
                        <i class="fas fa-search-minus"></i>
                    </button>
                    <button id="zoom-reset" class="btn btn-light" title="Restablecer zoom">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <!-- Filtro para inspecciones dentro del mapa -->
                <div id="map-filter" class="position-absolute p-2 bg-white border rounded" style="top: 10px; right: 10px; z-index: 1000;">
                    <label for="filterIncidente" class="form-label">Filtrar por estado:</label>
                    <select id="filterIncidente" class="form-control">
                        <option value="all">Todos</option>
                        <option value="0">Activos</option>
                        <option value="1">Cerrados</option>
                        <option value="2">Resueltos</option>
                    </select>
                </div>

                <!-- Mapa -->
                <div id="map"></div>
            </div>
        </div>
    </div>

    <tr>
        <div class="row mt-3">
            <div class="form-group mb-3 col-6">
                <label class="control-label">Filtrar por proyecto</label>
                <select id="proyecto-filter" class="form-control">
                    <option value="">Todos los proyectos</option>
                    <!-- Las opciones se llenarán dinámicamente -->
                </select>
            </div>
            <div class="form-group mb-3 col-6">
                <label class="control-label">Filtrar por tipo de incidente</label>
                <select id="tipo-incidente-filter" class="form-control">
                    <option value="">Todos los tipos de incidentes</option>
                    <!-- Las opciones se llenarán dinámicamente -->
                </select>
            </div>
        </div>
    </tr>
    <table id="example1" class="table table-bordered table-striped">
        <thead class="header-bg">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Titulo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FechaIncidente)
                </th>
                <th>
                    Proyecto Asociado
                </th>
                <th>
                    Tipo de Incidente
                </th>
                <th>
                    Estado Actual
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-proyecto="@item.Proyecto.Id" data-tipo-incidente="@item.TipoIncidente.Id">
                    <td>
                        @Html.DisplayFor(modelItem => item.Titulo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FechaIncidente)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Proyecto.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TipoIncidente.Titulo)
                    </td>
                    <td>
                        <span class="badge @(item.Estado == EstadoIncidenteEnum.Activo ? "badge-sin-responder" :
                                              item.Estado == EstadoIncidenteEnum.Vencido ? "badge-programada" :
                                              item.Estado == EstadoIncidenteEnum.Solucionado ? "badge-aprobada" :
                                              item.Estado == EstadoIncidenteEnum.Cerrado ? "badge-cerrado" : "")">
                            @Html.DisplayFor(modelItem => item.Estado)
                        </span>
                    </td>
                    <td>
                        <a href="#" class="edit-item" data-url="@Url.Action("Details", "Incidentes", new { id = item.Id })" data-title="Detalles del incidente" data-action="details">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                            </svg>
                        </a>
                        @if (item.Estado == EstadoIncidenteEnum.Activo)
                        {
                            if(esCoordinador || esResidente)
                            {
                                <a href="#" type="button" class="respond-item"
                                   data-url="@Url.Action("Create", "NovedadesIncidentes", new { incidenteId = item.Id })"
                                   data-title="Agregar Novedad"
                                   data-action="respond">
                                    <i class="fas fa-plus-circle"></i>
                                </a>
                                <a href="#" type="button" class="respond-item"
                                   data-url="@Url.Action("Create", "Lesionadoes", new { incidenteId = item.Id })"
                                   data-title="Agregar Novedad"
                                   data-action="respond">
                                    <i class="fas fa-user-injured"></i>
                                </a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    var municipiosConIncidentes = ViewBag.MunicipiosConIncidentes as List<string>;
}
<script src="\js\inicializacionyfiltrotableincidente.js"></script>
<script>
    // Convertir el ViewBag en una variable JavaScript global
    var municipiosConIncidentes = @Html.Raw(Json.Serialize(ViewBag.MunicipiosConIncidentes));
    window.municipiosConIncidentes = municipiosConIncidentes;

    // Verificar el contenido de ViewBag.DetallesIncidentes
    var detallesIncidentes = @Html.Raw(Json.Serialize(ViewBag.DetallesIncidentes));
    console.log('Detalles de Inspecciones:', detallesIncidentes);

    window.incidentes = detallesIncidentes;
    console.log('Inspecciones:', window.incidentes);
</script>