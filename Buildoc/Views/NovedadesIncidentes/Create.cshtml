@model NovedadesIncidenteViewModel

@{
    ViewData["Title"] = "Create";
    var esCoordinador = User.IsInRole("Coordinador");
}

<div class="row justify-content-center mb-4">
    <div class="col-md-12">
        <form asp-action="Create" class="ml-3 mr-3" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NovedadesIncidente.IncidenteId" />
            <div class="card-container">
                <div class="card">
                    <!-- Card para Detalles de Incidente -->
                    <div class="card-body">
                        <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del incidente</h6>
                        <dl class="row mb-0 dl-horizontal">
                            <dt class="col-sm-4">Tipo de incidente</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.TipoIncidente?.Titulo</dd>
                            <dt class="col-sm-4">Incidente</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.Titulo</dd>
                            <dt class="col-sm-4">fecha</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.FechaIncidente.ToShortDateString()</dd>
                            <dt class="col-sm-4">Hora</dt>
                            <dd class="col-sm-8 text-muted">@(Model.Incidente.HoraIncidente.HasValue ? Model.Incidente.HoraIncidente.Value.ToString() : "Desconocida")</dd>
                            <dt class="col-sm-4">Descripción</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.Descripcion</dd>
                        </dl>
                    </div>
                </div>
                <div class="card">
                    <!-- Card para Detalles de Respuesta proyecto -->
                    <div class="card-body">
                        <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del proyecto</h6>
                        <dl class="row mb-0 dl-horizontal">
                            <dt class="col-sm-4">Nombre</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.Proyecto.Nombre</dd>
                            <dt class="col-sm-4">Departamento</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.Proyecto.Departamento</dd>
                            <dt class="col-sm-4">Municipio</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.Proyecto.Municipio</dd>
                            <dt class="col-sm-4">Direccion</dt>
                            <dd class="col-sm-8 text-muted">@Model.Incidente.Proyecto.Direccion</dd>
                        </dl>
                    </div>
                </div>
            </div>
            @if (esCoordinador)
            {
                <div class="form-group">
                    <label class="control-label">¿Desea cambiar el estado del incidente?</label>
                    <input type="checkbox" id="MostrarEstadoCheck" data-bootstrap-switch>
                </div>
                <div class="form-group" id="SelectEstadoIncidente" style="display: none;">
                    <label class="control-label">Estado del Incidente</label>
                    <select name="EstadoIncidenteNovedad" class="form-control">
                        <option value="">Seleccione un estado</option>
                        @if (Model.Incidente.Estado == EstadoIncidenteEnum.Activo)
                        {
                            <option value="Cerrado">Cerrado</option>
                            <option value="Solucionado">Solucionado</option>
                        }
                        else if (Model.Incidente.Estado == EstadoIncidenteEnum.Cerrado)
                        {
                            <option value="Activo">Activo</option>
                            <option value="Solucionado">Solucionado</option>
                        }
                    </select>
                </div>
            }
            <div class="form-group">
                <label asp-for="NovedadesIncidente.Descripcion" class="control-label"></label>
                <textarea asp-for="NovedadesIncidente.Descripcion" class="form-control"></textarea>
                <span asp-validation-for="NovedadesIncidente.Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="UploadedFiles">Subir Archivos</label>
                <input type="file" name="UploadedFiles" id="UploadedFiles" multiple />
            </div>
            <script>
                $(document).ready(function () {
                    // Maneja el cambio en el checkbox
                    $('#MostrarEstadoCheck').on('change', function () {
                        if ($(this).is(':checked')) {
                            $('#SelectEstadoIncidente').show();  // Muestra el select
                        } else {
                            $('#SelectEstadoIncidente').hide();  // Oculta el select
                            // Establece el valor del select al valor predeterminado
                            $('#SelectEstadoIncidente select').val('');
                        }
                    });

                    // Opcional: Si necesitas inicializar el estado del select basado en el estado del checkbox al cargar la página
                    $('#MostrarEstadoCheck').trigger('change');
                });
            </script>
        </form>
    </div>
</div>
