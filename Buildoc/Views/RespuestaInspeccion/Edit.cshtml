@model Buildoc.Models.RespuestaInspeccion

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit</title>
</head>
<body>

<h4>RespuestaInspeccion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="InspeccionId" class="control-label"></label>
                <select asp-for="InspeccionId" class="form-control" asp-items="ViewBag.InspeccionId"></select>
                <span asp-validation-for="InspeccionId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Resultado" class="control-label"></label>
                <input asp-for="Resultado" class="form-control" />
                <span asp-validation-for="Resultado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Observaciones" class="control-label"></label>
                <input asp-for="Observaciones" class="form-control" />
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaRespuesta" class="control-label"></label>
                <input asp-for="FechaRespuesta" class="form-control" />
                <span asp-validation-for="FechaRespuesta" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="EsNecesariaInspeccionAdicional" /> @Html.DisplayNameFor(model => model.EsNecesariaInspeccionAdicional)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AccionesCorrectivas" /> @Html.DisplayNameFor(model => model.AccionesCorrectivas)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="AccionesCorrectivasLista" class="control-label"></label>
                <input asp-for="AccionesCorrectivasLista" class="form-control" />
                <span asp-validation-for="AccionesCorrectivasLista" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="DocumentacionCompleta" /> @Html.DisplayNameFor(model => model.DocumentacionCompleta)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="RecomendacionesFuturas" /> @Html.DisplayNameFor(model => model.RecomendacionesFuturas)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="RecomendacionesFuturasList" class="control-label"></label>
                <input asp-for="RecomendacionesFuturasList" class="form-control" />
                <span asp-validation-for="RecomendacionesFuturasList" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InspeccionAdicionalId" class="control-label"></label>
                <select asp-for="InspeccionAdicionalId" class="form-control" asp-items="ViewBag.InspeccionAdicionalId"></select>
                <span asp-validation-for="InspeccionAdicionalId" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
</body>
</html>
