@model Buildoc.Models.RespuestaInspeccion

@{
    var inspeccionDetalles = ViewData["InspeccionDetalles"] as Inspeccion;
    var inspeccionId = ViewData["InspeccionId"] as Guid?;
}

<div class="row">
    <!-- Detalles de la Inspección -->
    <div class="col-12">
        <div class="card card-outline card-primary collapsed-card">
            <div class="card-header">
                <h3 class="card-title">Detalles de la inspección</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">Objetivo:</dt>
                    <dd class="col-sm-8 text-muted">@inspeccionDetalles?.Objetivo</dd>
                    <dt class="col-sm-4">Descripción:</dt>
                    <dd class="col-sm-8 text-muted">@inspeccionDetalles?.Descripcion</dd>
                    <dt class="col-sm-4">Estado:</dt>
                    <dd class="col-sm-8 text-muted">
                        <span class="badge @(Model.Inspeccion.Estado == EstadoInspeccion.Programada ? "badge-programada" :
                        Model.Inspeccion.Estado == EstadoInspeccion.PendientesDeRevision ? "badge-pendiente-revision" :
                        Model.Inspeccion.Estado == EstadoInspeccion.SinResponder ? "badge-sin-responder" :
                        Model.Inspeccion.Estado == EstadoInspeccion.Aprobada ? "badge-aprobada" :
                        Model.Inspeccion.Estado == EstadoInspeccion.Desaprobada ? "badge-desaprobada" : "")">
                            @Html.DisplayFor(model => model.Inspeccion.Estado)
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<form asp-action="Edit" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="InspeccionId" value="@inspeccionId" />

    <div class="form-group">
        <label asp-for="Resultado" class="control-label"></label>
        <textarea asp-for="Resultado" class="form-control"></textarea>
        <span asp-validation-for="Resultado" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Observaciones" class="control-label">Observaciones (Opcional)</label>
        <textarea asp-for="Observaciones" class="form-control"></textarea>
        <span asp-validation-for="Observaciones" class="text-danger"></span>
    </div>

    <!-- Switch de Inspección Adicional -->
    <div class="form-group">
        <input type="checkbox" asp-for="EsNecesariaInspeccionAdicional" data-bootstrap-switch />
        <label asp-for="EsNecesariaInspeccionAdicional">@Html.DisplayNameFor(model => model.EsNecesariaInspeccionAdicional)</label>
    </div>

    <div class="form-group">
        <input type="checkbox" name="AccionesCorrectivas" data-bootstrap-switch
               asp-for="AccionesCorrectivas" id="accionesCorrectivasSwitch" />
        <label>@Html.DisplayNameFor(model => model.AccionesCorrectivas)</label>
    </div>
    <div class="form-group" id="accionesCorrectivasListaGroup" style="display:none;">
        <label asp-for="AccionesCorrectivasLista" class="control-label"></label>
        <input asp-for="AccionesCorrectivasLista" class="form-control" />
        <span asp-validation-for="AccionesCorrectivasLista" class="text-danger"></span>
    </div>



    <div class="form-group">
        <input type="checkbox" name="RecomendacionesFuturas" data-bootstrap-switch
               asp-for="RecomendacionesFuturas" id="recomendacionesFuturasSwitch" />
        <label asp-for="RecomendacionesFuturas">@Html.DisplayNameFor(model => model.RecomendacionesFuturas)</label>
    </div>
    <div class="form-group" id="recomendacionesFuturasListGroup" style="display:none;">
        <label class="control-label">¿Se requieren medidas correctivas futuras?</label>
        <input asp-for="RecomendacionesFuturasList" class="form-control" />
        <span asp-validation-for="RecomendacionesFuturasList" class="text-danger"></span>
    </div>

    <!-- Campo para subir archivos -->
    <div class="form-group">
        <label for="UploadedFiles">Subir Archivos</label>
        <input type="file" name="archivos" id="UploadedFiles" multiple />
    </div>

    <!-- Campo para subir imágenes -->
    <div class="form-group">
        <label for="imageUpload">Subir Imágenes</label>
        <input type="file" id="imageUpload" name="images" multiple accept="image/*" onchange="previewImages()" />
        <div id="imagePreview" class="mt-2"></div>
    </div>

   
</form>


    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/detalleInspeccion.js"></script>
    <script>
        $(document).ready(function () {
            // Inicializar los switches
            $("input[data-bootstrap-switch]").each(function () {
                $(this).bootstrapSwitch({
                    onText: 'Sí',
                    offText: 'No'
                });
            });

            // Mostrar/ocultar los campos según el estado inicial de los switches
            toggleAccionesCorrectivasLista();
            toggleRecomendacionesFuturasList();

            // Detectar cambios en el switch de Acciones Correctivas y mostrar/ocultar el input
            $('#accionesCorrectivasSwitch').on('switchChange.bootstrapSwitch', function (event, state) {
                toggleAccionesCorrectivasLista();
            });

            // Detectar cambios en el switch de Recomendaciones Futuras y mostrar/ocultar el input
            $('#recomendacionesFuturasSwitch').on('switchChange.bootstrapSwitch', function (event, state) {
                toggleRecomendacionesFuturasList();
            });
            function toggleAccionesCorrectivasLista() {
                if ($('#accionesCorrectivasSwitch').bootstrapSwitch('state')) {
                    $('#accionesCorrectivasListaGroup').show();
                } else {
                    $('#accionesCorrectivasListaGroup').hide();
                }
            }

            function toggleRecomendacionesFuturasList() {
                if ($('#recomendacionesFuturasSwitch').bootstrapSwitch('state')) {
                    $('#recomendacionesFuturasListGroup').show();
                } else {
                    $('#recomendacionesFuturasListGroup').hide();
                }
            }

            function previewImages() {
                const imagePreview = document.getElementById('imagePreview');
                imagePreview.innerHTML = ''; // Limpiar vista previa anterior

                const files = document.getElementById('imageUpload').files;
                for (const file of files) {
                    const reader = new FileReader();

                    reader.onload = function (event) {
                        const imgElement = document.createElement('img');
                        imgElement.src = event.target.result;
                        imgElement.style.width = '100px'; // Ajustar el tamaño de la miniatura
                        imgElement.style.height = 'auto'; // Mantener proporción
                        imgElement.style.marginRight = '10px'; // Espaciado entre miniaturas

                        imagePreview.appendChild(imgElement);
                    };

                    reader.readAsDataURL(file);
                }
            }
        });
    </script>

<script src="/js/tamanoArchivos.js"></script>