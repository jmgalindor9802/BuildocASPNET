    @model Buildoc.Models.Inspecciones.NovedadInspeccion

    @{
        Layout = null;

        var esCoordinador = User.IsInRole("Coordinador");

        var estadoInspeccion = ViewData["EstadoInspeccion"]?.ToString();
        var inspeccion = ViewData["Inspeccion"] as Buildoc.Models.Inspeccion;
        var respuestaInspeccion = ViewData["RespuestaInspeccion"] as Buildoc.Models.RespuestaInspeccion;

    }

    <!DOCTYPE html>

    <html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <title>Create</title>
        <style>
            .card-container {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem; /* Ajusta el espacio entre las tarjetas según sea necesario */
            }

            .card {
                display: flex;
                flex-direction: column;
            }

            .card-body {
                flex: 1; /* Permite que el contenido dentro de la tarjeta se expanda para igualar la altura */
            }
        </style>
    
    
    </head>


    <body>



    <div class="row">

        <div class="col-md-12">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" name="idInspeccion" value="@ViewData["InspeccionId"]" />
                <input type="hidden" id="hiddenActionAprobacion" name="actionAprobacion" />

                    <div class="card-container">
                        <div class="card">
                            <!-- Card para Detalles de Inspección -->
                            <div class="card-body">
                                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles de la Inspección</h6>
                                <dl class="row mb-0 dl-horizontal">
                                    <dt class="col-sm-4">Objetivo</dt>
                                    <dd class="col-sm-8 text-muted">@inspeccion?.Objetivo</dd>
                                    <dt class="col-sm-4">Descripción</dt>
                                    <dd class="col-sm-8 text-muted">@inspeccion?.Descripcion</dd>
                                    <dt class="col-sm-4">Fecha de Inspección</dt>
                                    <dd class="col-sm-8 text-muted">@inspeccion?.FechaInspeccion.ToString("dd/MM/yyyy")</dd>
                                    <!-- Agrega más campos según sea necesario -->
                                </dl>
                            </div>
                        </div>

                        <div class="card">
                            <!-- Card para Detalles de Respuesta Inspección -->
                            <div class="card-body">
                                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles de la Respuesta de Inspección</h6>
                                <dl class="row mb-0 dl-horizontal">
                                    <dt class="col-sm-4">Documentación:</dt>
                                    <dt class="col-sm-12">Acciones correctivas en sitio:</dt>
                                    <dd class="col-sm-12 text-muted">
                                        @(string.IsNullOrWhiteSpace(respuestaInspeccion?.AccionesCorrectivasLista) ? "Ninguna" : respuestaInspeccion.AccionesCorrectivasLista)
                                    </dd>
                                    <dt class="col-sm-4">Observaciones:</dt>
                                    <dd class="col-sm-8 text-muted">@respuestaInspeccion?.Observaciones</dd>
                                    <!-- Agrega más campos según sea necesario -->
                                </dl>
                            </div>
                        </div>
                    </div>

                  
                <div class="form-group">
                    <label asp-for="Comentario" class="control-label"></label>
                    <input asp-for="Comentario" class="form-control" />
                    <span asp-validation-for="Comentario" class="text-danger"></span>
                </div>
                <!-- Campo de carga de archivos -->
                <div class="form-group">
                    <label for="archivos">Subir Archivos:</label>
                    <input type="file" id="archivos" name="archivos" multiple class="form-control-file" />
                </div>
                @if (!esCoordinador && estadoInspeccion == "Desaprobada")
                {
                    <div class="form-group">
                        <input type="checkbox" id="chkVolverRevision" />
                        <label for="chkVolverRevision">Volver a revisión</label>
                    </div>
                }
                @if (esCoordinador && estadoInspeccion != "Programada")
                    {
                        <div class="form-group">
                            <label class="switch-label">¿Aprueba la respuesta de la inspección?</label>
                            <input type="checkbox" id="chkAprobar" />
                            <div id="approvalButtons" style="display:none;">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-success" id="btnAprobar">Aprobar</button>
                                    <button type="button" class="btn btn-danger" id="btnDesaprobar">Desaprobar</button>
                                </div>
                            </div>
                        </div>
                    }


            </form>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $("#chkAprobar").change(function () {
                if ($(this).is(":checked")) {
                    $("#approvalButtons").show();
                } else {
                    $("#approvalButtons").hide();
                    $('#hiddenActionAprobacion').val(''); // Limpia el valor si el checkbox no está marcado
                }
            });

            $("#btnAprobar").click(function () {
                $('#hiddenActionAprobacion').val('Aprobar');
            });

            $("#btnDesaprobar").click(function () {
                $('#hiddenActionAprobacion').val('Desaprobar');
            });


            $("#chkVolverRevision").change(function () {
                if ($(this).is(":checked")) {
                    $('#hiddenActionAprobacion').val('Devolver');
                } else {
                    // Aquí decides qué hacer si el checkbox no está marcado
                    $('#hiddenActionAprobacion').val(''); // O un valor predeterminado
                }
            });

            $("#createNovedadForm").submit(function (event) {
                event.preventDefault(); // Previene el envío tradicional del formulario
              
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            toastr.success('Novedad guardada con éxito.');
                            // Cierra el modal si es necesario
                            $('#modalDetalles').modal('hide');
                        } else {
                            toastr.error('Hubo un error al guardar la novedad.');
                        }
                    },
                    error: function () {
                        toastr.error('Error de comunicación con el servidor.');
                    }
                });
            });

        });
    </script>
    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
    </body>
    </html>
