@model Buildoc.Models.Proyectos.DesarchivarViewModel



@using (Html.BeginForm("EditFinalizacion", "Proyectos", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.FechaFinalizacion, new { @class = "control-label" })
        @Html.EditorFor(model => model.FechaFinalizacion, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.FechaFinalizacion, "", new { @class = "text-danger" })
    </div>

    <!-- Campo oculto para enviar el Id del proyecto -->
    @Html.HiddenFor(model => model.Id)
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
    </div>
}
