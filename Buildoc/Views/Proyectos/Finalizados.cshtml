@model IEnumerable<Buildoc.Models.Proyecto>

@{
    ViewData["Title"] = "Index";
}
<div class="container-page">


    <div class="row mb-4 align-items-center text-white p-3 bg-success" >
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="mb-0">
                <i class="fas fa-check-circle"></i> Proyectos finalizados
            </h1><p class="mb-0">
                <a href="@Url.Action("Index", "Proyectos")" class="btn btn-light">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            </p>
        </div>
    </div>



<table id="example1" class="table table-bordered table-striped">
        <thead class="header-bg">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Municipio)
            </th>
                <th>
                    @Html.DisplayNameFor(model => model.Direccion)
                </th>
            <th>
                @Html.DisplayNameFor(model => model.Cliente)
            </th>
                
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                <td>@Html.DisplayFor(modelItem => item.Municipio)</td>
                    <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                <td>@Html.DisplayFor(modelItem => item.Cliente)</td>

                    <td>
                        <a href="#" style="color: blue;" class="edit-item"
                           data-url="@Url.Action("Edit", "Proyectos", new { id = item.Id })"
                           title="Editar proyecto">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                            </svg>
                        </a>

                        <a href="#" class="details-view"
                           data-url="@Url.Action("Details", "Proyectos", new { id = item.Id })"
                           title="Detalles del proyecto">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                            </svg>
                        </a>

                        <a href="#" class="desarchivar-item"
                           data-url="@Url.Action("Desarchivar", "Proyectos", new { id = item.Id })"
                           style="color: green;"
                           title="Desarchivar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 0 0 .708.708L7.5 2.707V14.5A.5.5 0 0 0 8 15z" />
                            </svg>
                            <span class="sr-only">Desarchivar</span>
                        </a>



                </td>
            </tr>
        }

    </tbody>
</table>

    <!-- Modal -->
    <div class="modal fade" id="updateFinalizacionModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Desarchivar Proyecto</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="modalContent">
                    <!-- Aquí se cargará el contenido de la vista parcial -->
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('.desarchivar-item').on('click', function (e) {
                e.preventDefault();
                var url = $(this).data('url');
                $('#modalContent').load(url, function () {
                    $('#updateFinalizacionModal').modal('show');
                });
            });

            // Manejar el envío del formulario dentro del modal
            $(document).on('submit', 'form', function (e) {
                e.preventDefault(); // Evitar el envío del formulario de forma tradicional
                var $form = $(this);
                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    data: $form.serialize(),
                    success: function (response) {
                        if (response.success) {
                            // Cerrar el modal
                            $('#updateFinalizacionModal').modal('hide');
                            // Recargar la página
                            location.reload();
                        } else {
                            // Cargar el contenido de error en el modal si el formulario no es válido
                            $('#modalContent').html(response);
                        }
                    }
                });
            });
        });
    </script>
    <script src="~/js/datatable-config.js"></script>
    <script src="/espanol.js"></script>
