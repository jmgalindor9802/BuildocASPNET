@model Buildoc.Models.IncidenteLesionado

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del proyecto</h6>
                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Proyecto.Nombre)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Proyecto.Nombre)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Proyecto.Departamento)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Proyecto.Departamento)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Proyecto.Municipio)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Proyecto.Municipio)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Proyecto.Direccion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Proyecto.Direccion)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Proyecto.Cliente)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Proyecto.Cliente)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Proyecto.Descripcion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Proyecto.Descripcion)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del Incidente</h6>
                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Titulo)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Titulo)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.FechaIncidente)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.FechaIncidente)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Incidente.Descripcion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Incidente.Descripcion)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Detalles del lecionado</h6>
                <dl class="row mb-0 dl-horizontal">
                    <dt class="col-sm-4">Nombre completo</dt>
                    <dd class="col-sm-8 text-muted">@Model.Lesionado.Nombre @Model.Lesionado.Apellido</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Lesionado.Cedula)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Lesionado.Cedula)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ActividadRealizada)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.ActividadRealizada)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Defuncion)</dt>
                    <dd class="col-sm-8 text-muted">
                        @(Model.Defuncion ? "Sí" : "No")
                    </dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AsociadaProyecto)</dt>
                    <dd class="col-sm-8 text-muted">
                        @(Model.AsociadaProyecto ? "Sí" : "No")
                    </dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.GeneroAfectado)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.GeneroAfectado)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Hospitalizado)</dt>
                    <dd class="col-sm-8 text-muted">
                        @(Model.Hospitalizado ? "Sí" : "No")
                    </dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PrimerosAuxilios)</dt>
                    <dd class="col-sm-8 text-muted">
                        @(Model.PrimerosAuxilios ? "Sí" : "No")
                    </dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FechaCreacion)</dt>
                    <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.FechaCreacion)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
