@model Buildoc.Models.IncidenteLesionado

@{
    ViewData["Title"] = "Edit";
}


<div class="row justify-content-center mb-4">
    <div class="col-md-12">
        <form asp-action="Edit" class="ml-3 mr-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IncidenteId" /> <!-- Cambiado de Incidente.Id a IncidenteId -->
            <input type="hidden" asp-for="LesionadoId" /> <!-- Cambiado de Lesionado.Id a LesionadoId -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Lesionado.Cedula" class="control-label"></label>
                        <input asp-for="Lesionado.Cedula" class="form-control" readonly/>
                        <span asp-validation-for="Lesionado.Cedula" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Lesionado.CorreoElectronico" class="control-label"></label>
                        <input asp-for="Lesionado.CorreoElectronico" class="form-control" />
                        <span asp-validation-for="Lesionado.CorreoElectronico" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Lesionado.Nombre" class="control-label"></label>
                        <input asp-for="Lesionado.Nombre" class="form-control" />
                        <span asp-validation-for="Lesionado.Nombre" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Lesionado.Apellido" class="control-label"></label>
                        <input asp-for="Lesionado.Apellido" class="form-control" />
                        <span asp-validation-for="Lesionado.Apellido" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <!-- IncidenteLesionado Fields -->
            <div class="form-group">
                <label asp-for="GeneroAfectado" class="control-label"></label>
                <select asp-for="GeneroAfectado" class="form-control">
                    <option value="Hombre">Hombre</option>
                    <option value="Mujer">Mujer</option>
                </select>
                <span asp-validation-for="GeneroAfectado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Defuncion" class="control-label">¿El afectado está muerto?</label>
                <select asp-for="Defuncion" class="form-control">
                    <option value="false">No</option>
                    <option value="true">Sí</option>
                </select>
                <span asp-validation-for="Defuncion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AsociadaProyecto" class="control-label">¿El afectado es un trabajador?</label>
                <select asp-for="AsociadaProyecto" class="form-control">
                    <option value="false">No</option>
                    <option value="true">Sí</option>
                </select>
                <span asp-validation-for="AsociadaProyecto" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrimerosAuxilios" class="control-label">¿Se brindaron primeros auxilios?</label>
                <select asp-for="PrimerosAuxilios" class="form-control">
                    <option value="false">No</option>
                    <option value="true">Sí</option>
                </select>
                <span asp-validation-for="PrimerosAuxilios" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Hospitalizado" class="control-label">¿Tuvieron que hospitalizar al lesionado?</label>
                <select asp-for="Hospitalizado" class="form-control">
                    <option value="false">No</option>
                    <option value="true">Sí</option>
                </select>
                <span asp-validation-for="Hospitalizado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ActividadRealizada" class="control-label">Descripción de la actividad realizada durante el incidente</label>
                <textarea asp-for="ActividadRealizada" class="form-control" readonly></textarea>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
