@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}
@* Carrucel *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Buildoc</title>
    <meta content="" name="keywords">
    <meta content="" name="description">
    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/lib/animate/animate.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Buildoc.styles.css" asp-append-version="true" />
    <style>

        .team-item {
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .team-img {
            position: relative;
            width: 100%;
            padding-top: 100%; /* Esto hace que el contenedor sea cuadrado */
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .team-img img {
                position: absolute;
                top: 50%;
                left: 50%;
                width: 100%;
                height: 100%;
                object-fit: cover;
                transform: translate(-50%, -50%);
            }

        .team-social {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
        }
    </style>
</head>
<body>
    <!-- Topbar Start -->
    <div class="container-fluid bg-dark px-5 d-none d-lg-block">
        <div class="row gx-0">
            <div class="col-lg-8 text-center text-lg-start mb-2 mb-lg-0">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <small class="me-3 text-light"><i class="fa fa-map-marker-alt me-2"></i>Kr 13 # 65 - 15, Bogotá D.C, Colombia</small>
                    <small class="me-3 text-light"><i class="fa fa-phone-alt me-2"></i>3134541985</small>
                    <small class="text-light"><i class="fa fa-envelope-open me-2"></i>buildoc2@gmail.com</small>
                </div>
            </div>
            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-twitter fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-facebook-f fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-linkedin-in fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-instagram fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle" href="https://www.youtube.com/channel/UC2N7eVWwKRTvLsUyvrH1hRg"><i class="fab fa-youtube fw-normal"></i></a>
                </div>
            </div>
        </div>
    </div>
    <!-- Topbar End -->
    <!-- Navbar & Carousel Start -->
    <div class="container-fluid position-relative p-0">
        <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3 py-lg-0 fixed-top">
            <a href="@Url.Action("Index", "Home")" class="navbar-brand p-0">
                <img src="/logo_buildoc_blanco.png" alt="Buildoc Logo" class="brand-image logo-transparent" style=" width: 120px; height: auto;" />
                <img src="/logo_buildoc_color.png" alt="Buildoc Logo" class="brand-image logo-white" style=" width: 120px; height: auto; display: none;">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse white-background" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a href="@Url.Action("Index", "Home")" class="nav-item nav-link active">Inicio</a>
                    <a href="#aboaut" class="nav-item nav-link">Nosotros</a>
                    <a href="#eligenos" class="nav-item nav-link">Por qué elegirnos</a>
                    <a href="#nuestrosServicios" class="nav-item nav-link">Manual</a>
                    <a href="#Team" class="nav-item nav-link">Equipo de trabajo</a>
                </div>
                <button type="button" class="btn text-primary ms-3" data-bs-toggle="modal" data-bs-target="#searchModal">
                    <i class="fa fa-search"></i>
                </button>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </div>
    <div id="header-carousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/imgcarrucel1.jpg" alt="Image">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <div class="p-3" style="max-width: 900px;">
                        <h5 class="text-white text-uppercase mb-3 animated slideInDown">Transformación Digital</h5>
                        <h1 class="display-1 text-white mb-md-4 animated zoomIn">Innovación en Gestión Documental de inspecciones e incidentes para Construcción</h1>
                        <p class="text-white mb-4 animated slideInUp">Centraliza la información, optimiza la administración de inspecciones e incidentes, y mejora la comunicación entre los actores del proyecto.</p>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/imgcarrucel2.jpg" alt="Image">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <div class="p-3" style="max-width: 900px;">
                        <h5 class="text-white text-uppercase mb-3 animated slideInDown">Eficiencia y Seguridad</h5>
                        <h1 class="display-1 text-white mb-md-4 animated zoomIn">>Optimización en la Gestión de Proyectos de Construcción</h1>
                        <p class="text-white mb-4 animated slideInUp">Nuestro sistema BUILDOC asegura la integridad y disponibilidad de los documentos críticos, mejorando la eficiencia y reduciendo errores.</p>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    @* Fin del carrucel *@

    <!-- About Start -->
    <div id="aboaut" class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-7">
                    <div class="section-title position-relative pb-3 mb-5">
                        <h5 class="fw-bold text-primary text-uppercase">Nosotros</h5>
                        <h1 class="mb-0">Transformamos la Gestión de Proyectos de Construcción</h1>
                    </div>
                    <p class="mb-4">En SERVINCO INGENIERÍA SAS, nos dedicamos a mejorar la eficiencia y efectividad en la planificación, supervisión y documentación de proyectos de construcción a través de nuestra solución BUILDOC. Nuestro sistema de gestión documental y de inspecciones está diseñado para centralizar la información, optimizar la administración y mejorar la comunicación entre todos los actores involucrados en un proyecto. Con más de una década de experiencia en la industria, nuestro objetivo es ofrecer una plataforma que garantice la seguridad de la información, la accesibilidad y la integridad de los datos, enfrentando las deficiencias actuales en la gestión documental.</p>
                    <div class="row g-0 mb-3">
                        <div class="col-sm-6 wow zoomIn" data-wow-delay="0.2s">
                            <h5 class="mb-3"><i class="fa fa-check text-primary me-3"></i>Innovación Continua</h5>
                            <h5 class="mb-3"><i class="fa fa-check text-primary me-3"></i>Soluciones Personalizadas</h5>
                        </div>
                        <div class="col-sm-6 wow zoomIn" data-wow-delay="0.4s">
                            <h5 class="mb-3"><i class="fa fa-check text-primary me-3"></i>Compromiso con la Calidad</h5>
                            <h5 class="mb-3"><i class="fa fa-check text-primary me-3"></i>Atención Personalizada</h5>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-4 wow fadeIn" data-wow-delay="0.6s">
                        <div class="bg-primary d-flex align-items-center justify-content-center rounded" style="width: 60px; height: 60px;">
                            <i class="fa fa-phone-alt text-white"></i>
                        </div>
                        <div class="ps-4">
                            <h5 class="mb-2">Para cualquier consulta</h5>
                            <h4 class="text-primary mb-0">+57 (302) 394-3920</h4>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5" style="min-height: 500px;">
                    <div class="position-relative h-100">
                        <img class="position-absolute w-100 h-100 rounded wow zoomIn" data-wow-delay="0.9s" src="~/about.jpg" style="object-fit: cover;">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- About End -->
    <!-- Features Start -->
    <div id="eligenos" class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="section-title text-center position-relative pb-3 mb-5 mx-auto" style="max-width: 600px;">
                <h5 class="fw-bold text-primary text-uppercase">Por Qué Elegirnos</h5>
                <h1 class="mb-0">Impulsa la Eficiencia y Seguridad en tus Proyectos de Construcción</h1>
            </div>
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="row g-5">
                        <div class="col-12 wow zoomIn" data-wow-delay="0.2s">
                            <div class="bg-primary rounded d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="fa fa-cubes text-white"></i>
                            </div>
                            <h4>Innovación Continua</h4>
                            <p class="mb-0">>Nuestro sistema se actualiza constantemente para ofrecer las últimas funcionalidades en gestión documental y control de proyectos.</p>
                        </div>
                        <div class="col-12 wow zoomIn" data-wow-delay="0.6s">
                            <div class="bg-primary rounded d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="fa fa-award text-white"></i>
                            </div>
                            <h4>Seguridad de Datos</h4>
                            <p class="mb-0">Implementamos medidas de seguridad avanzadas para proteger la integridad y confidencialidad de tu información crítica.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4  wow zoomIn" data-wow-delay="0.9s" style="min-height: 350px;">
                    <div class="position-relative h-100">
                        <img class="position-absolute w-100 h-100 rounded wow zoomIn" data-wow-delay="0.1s" src="~/features.jpg" style="object-fit: cover;">
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="row g-5">
                        <div class="col-12 wow zoomIn" data-wow-delay="0.4s">
                            <div class="bg-primary rounded d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="fa fa-users-cog text-white"></i>
                            </div>
                            <h4>Soporte Personalizado</h4>
                            <p class="mb-0">Nuestro equipo de soporte está disponible para resolver tus dudas y asegurarse de que obtengas el máximo provecho del sistema.</p>
                        </div>
                        <div class="col-12 wow zoomIn" data-wow-delay="0.8s">
                            <div class="bg-primary rounded d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="fa fa-phone-alt text-white"></i>
                            </div>
                            <h4>Soluciones Personalizadas</h4>
                            <p class="mb-0">Ofrecemos soluciones a medida para satisfacer las necesidades específicas de cada proyecto y cliente.</p>
                        </div>
                    </div>
                </div>
            </div>
