                        <div class="service-icon">
                            <i class="fas fa-exclamation-triangle text-white"></i>
                        </div>
                        <h4 class="mb-3">Gestion de incidentes</h4>
                        <p class="m-0">Buildoc ofrece una forma sencilla e intuitiva de reportar incidentes, con funciones ajustadas según el rol del usuario.</p>
                        <a class="btn btn-lg btn-primary rounded" asp-action="ManuealIncidentes">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.3s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="service-icon">
                            <i class="fas fa-paste text-white"></i>
                        </div>
                        <h4 class="mb-3">Gestion de inspecciones</h4>
                        <p class="m-0">Buildoc ofrece una forma sencilla e intuitiva de programar y/o reponder inspecciones, con funciones ajustadas según el rol del usuario.</p>
                        <a class="btn btn-lg btn-primary rounded" asp-action="ManuealInspecciones">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
