    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<body>
    <!-- Proyectos Manual Start -->
    <div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                <!-- Tabla de contenido Start -->
                <div class="col-lg-3">
                    <div class="bg-light p-4 rounded">
                        <h4 class="text-primary mb-4">Tabla de Contenido</h4>
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" href="#crear-proyecto">Crear Proyecto</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#editar-proyecto">Editar Proyecto</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#eliminar-proyecto">Eliminar Proyecto</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <!-- Tabla de contenido End -->
                <!-- Contenido Start -->
                <div class="col-lg-9">
                    <div class="section-title position-relative pb-3 mb-5">
                        <h5 class="fw-bold text-primary text-uppercase">Manual de Proyectos</h5>
                        <h1 class="mb-0">Gestión de Proyectos</h1>
                    </div>

                    <div class="accordion" id="accordionProyectos">
                        <!-- Crear Proyecto -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="crear-proyecto">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCrearProyecto" aria-expanded="true" aria-controls="collapseCrearProyecto">
                                    Crear Proyecto
                                </button>
                            </h2>
                            <div id="collapseCrearProyecto" class="accordion-collapse collapse show" data-bs-parent="#accordionProyectos">
                                <div class="accordion-body">
                                    <p>Para crear un nuevo proyecto, ingresa en la sección "Proyectos" y selecciona "Crear proyecto". Aparecerá un formulario donde deberás ingresar la información del proyecto, como nombre, descripción, coordenador asignado, trabajadores, fechas y otros detalles relevantes. Haz clic en "Guardar" para finalizar el proceso de creación del proyecto.</p>
                                    <!-- Video explicativo -->
                                    <div class="video-responsive">
                                        <iframe width="560" height="315" src="https://www.youtube.com/embed/49wWIErF0XA?si=8QexkTShbCLoqWzC" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Editar Proyecto -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="editar-proyecto">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEditarProyecto" aria-expanded="false" aria-controls="collapseEditarProyecto">
                                    Editar Proyecto
                                </button>
                            </h2>
                            <div id="collapseEditarProyecto" class="accordion-collapse collapse" data-bs-parent="#accordionProyectos">
                                <div class="accordion-body">
                                    <p>Para editar un proyecto existente, selecciona el proyecto que deseas modificar desde la lista de proyectos, haz clic en "Editar", realiza los cambios necesarios en los detalles del proyecto, como fechas, personal asignado o descripción, y luego haz clic en "Guardar" para aplicar los cambios.</p>
                                    <!-- Video explicativo -->
                                    <div class="video-responsive">
                                        <iframe width="560" height="315" src="https://www.youtube.com/embed/Ai4042u5GsM?si=xwL6dpeeOfFwnOkW" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Eliminar Proyecto -->
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="eliminar-proyecto">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEliminarProyecto" aria-expanded="false" aria-controls="collapseEliminarProyecto">
                                    Eliminar Proyecto
                                </button>
                            </h2>
                            <div id="collapseEliminarProyecto" class="accordion-collapse collapse" data-bs-parent="#accordionProyectos">
                                <div class="accordion-body">
                                    <p>Para eliminar un proyecto, selecciona el proyecto que deseas eliminar desde la lista de proyectos, haz clic en "Eliminar" y confirma la acción en el diálogo emergente. Esta acción es irreversible y eliminará todos los datos relacionados con el proyecto.</p>
                                    <!-- Video explicativo -->
                                    <div class="video-responsive">
                                        <iframe width="560" height="315" src="https://www.youtube.com/embed/tJnHh55zVmo?si=vj8N6NG1UZmAjSii" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Contenido End -->
            </div>
        </div>
    </div>
    <!-- Proyectos Manual End -->
</body>
