@using Microsoft.AspNetCore.Identity
@using Buildoc.Models
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
        var usuario = await UserManager.GetUserAsync(User);
        var nombreCompleto = usuario?.NombreCompleto;

        @if (SignInManager.IsSignedIn(User))
        {
            @if (User.IsInRole("Administrador"))
            {
                <li class="nav-item">
                    <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                        <i class="fas fa-user-cog d-inline d-md-none"></i> <!-- Ícono visible solo en móvil -->
                        <span class="d-none d-md-inline">ADMINISTRADOR</span> <!-- Texto visible solo en pantallas medianas en adelante -->
                    </a>
                </li>
            }
            else if (User.IsInRole("Coordinador"))
            {
                <li class="nav-item">
                    <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                        <i class="fas fa-user d-inline d-md-none"></i> <!-- Ícono visible solo en móvil -->
                        <span class="d-none d-md-inline">@nombreCompleto</span> <!-- Texto visible solo en pantallas medianas en adelante -->
                    </a>
                </li>
            }
            else if (User.IsInRole("Residente"))
            {
                <li class="nav-item">
                    <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                        <i class="fas fa-user d-inline d-md-none"></i> <!-- Ícono visible solo en móvil -->
                        <span class="d-none d-md-inline">@nombreCompleto</span> <!-- Texto visible solo en pantallas medianas en adelante -->
                    </a>
                </li>
            }


            <li class="nav-item ml-auto">
                <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="btn btn-light">
                        <i class="fas fa-sign-out-alt"></i> <!-- Ícono para el botón de cerrar sesión -->
                        <span class="d-none d-md-inline">Cerrar sesión</span> <!-- Texto oculto en pantallas móviles -->
                    </button>
                </form>

            </li>
        }
}
else
{
        <li class="nav-item ml-auto">
            <form id="loginForm" class="form-inline" asp-area="Identity" asp-page="/Account/Login">
                <button id="login" type="submit" class="btn btn-primary py-2 px-lg-3 my-3 mx-2  d-lg-block">
                    Ingresar<i class="fa fa-arrow-right ms-3"></i>
                </button>
            </form>
        </li>

    @* <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li> *@
}
</ul>
