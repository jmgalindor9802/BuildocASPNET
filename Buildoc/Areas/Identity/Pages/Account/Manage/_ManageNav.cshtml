@inject SignInManager<Usuario> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<aside class="main-sidebar sidebar-dark-primary elevation-4" style=" background-color: #001f3f">
    <!-- Brand Logo -->
    <a href="@Url.Action("Index", "Home")" class="brand-link">
        <img src="/logo_buildoc_icono_blanco.png" alt="Buildoc Logo" class="brand-image" style="opacity: .8">
        <span class="brand-text font-weight-light">Servinco SAS</span>
    </a>
    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <li class="nav-item">
                    <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
                        <i class="nav-icon fas fa-user"></i> <p>Perfil</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
                        <i class="nav-icon fas fa-envelope"></i> <p>Correo electrónico</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
                        <i class="nav-icon fas fa-key"></i> <p>Contraseña</p>
                    </a>
                </li>
                @if (hasExternalLogins)
                {
                    <li class="nav-item"><a class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">Logins externos</a></li>
                }
            </ul>
        </nav>
    </div>
</aside>
