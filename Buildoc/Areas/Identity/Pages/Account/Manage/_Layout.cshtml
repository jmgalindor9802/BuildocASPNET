@using Microsoft.AspNetCore.Identity
@using Buildoc.Models
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Buildoc</title>
    <!-- Favicon -->
    <link rel="icon" href="~/HeadLogo.png" type="image/png">
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/AdminLTE/plugins/fontawesome-free/css/all.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="/AdminLTE/css/adminlte.min.css">
    <!-- jQuery -->
    <script src="/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="/AdminLTE/js/adminlte.min.js"></script> <!-- Necesario para el colapso del sidebar -->

    <style>
        /* .btn-save, .btn-delete, .btn-edit, .btn-restore {
                    display: inline-block !important;
                } */

        .btn-primary {
            background-color: #001f3f; /* Color de fondo personalizado */
            border-color: #001f3f; /* Color de borde personalizado */
            color: #ffffff; /* Color de texto personalizado */
        }

        .dl-horizontal dt {
            font-weight: normal; /* Quita la negrita del texto */
            font-size: 0.9em; /* Reduce el tamaño de la fuente */
        }

        .dl-horizontal dd {
            font-size: 0.9em; /* Reduce el tamaño de la fuente */
            color: #6c757d; /* Aplica la clase text-muted */
        }

        .header-bg {
            background-color: #001f3f; /* Color info de Bootstrap */
            color: white; /* Color del texto en el encabezado */
        }

        .user-role {
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 10px;
        }

        .user-role-text {
            margin-left: 10px;
        }

        .sidebar-mini.sidebar-collapse .user-role-text {
            display: none; /* Oculta el texto del rol cuando el sidebar está contraído */
        }

        .sidebar-mini.sidebar-collapse .user-role {
            justify-content: center; /* Alinea el ícono en el centro cuando el texto está oculto */
            width: 100%; /* Asegura que ocupe el mismo ancho */
        }

        /* Reducir el tamaño del título en pantallas pequeñas */
        @@media (max-width: 576px) {
            h1 {
                font-size: 1.5rem; /* Ajusta el tamaño del título en móviles */
            }
        }

    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <!-- Header Start -->
    <header>
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <!-- Botón de colapso -->
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Home")">
                        <img src="/logo_buildoc_color.png" alt="Buildoc Logo" class="brand-image" style="width: 120px; height: auto;">
                    </a>
                </li>
            </ul>

            <!-- Centrar el nombre de usuario -->
            <div class="mx-auto text-center">
                @if (SignInManager.IsSignedIn(User))
                {
                    var usuario = await UserManager.GetUserAsync(User);
                    var nombreCompleto = usuario?.NombreCompleto;

                    @if (User.IsInRole("Administrador"))
                    {
                        <span class="navbar-text text-dark">ADMINISTRADOR</span>
                    }
                    else
                    {
                        <i class="fas fa-user d-inline d-md-none"></i> <!-- Ícono visible solo en móvil -->
                        <h4 class="navbar-text text-dark d-none d-md-inline">@nombreCompleto</h4>
                    }
                }
            </div>

            <!-- Botones a la derecha -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-light">
                            <i class="fas fa-sign-out-alt"></i> <!-- Ícono para el botón de cerrar sesión -->
                            <span class="d-none d-md-inline">Cerrar sesión</span>
                        </button>
                    </form>
                </li>
            </ul>
        </nav>
    </header>
    <!-- Header End -->
    <!-- Main Content Start -->
    <div class="wrapper">
        <partial name="_ManageNav" /> <!-- Menú lateral -->
        <div class="content-wrapper">
            <div class="container-fluid mt-4">
                @RenderBody()
            </div>
        </div>
    </div>
    <!-- Main Content End -->
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @{
        // Ignorar la sección "Scripts" si no está definida
        IgnoreSection("Scripts");
    }
</body>
</html>
