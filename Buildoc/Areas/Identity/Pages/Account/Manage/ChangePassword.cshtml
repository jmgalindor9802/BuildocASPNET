@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambio de contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="card card-outline card-primary">
    <div class="card-header text-center">
        <h3>@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <partial name="_StatusMessage" for="StatusMessage" />
        <div class="row justify-content-center mb-4">
            <div class="col-md-8">
                <form id="change-password-form" class="ml-3 mr-3" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <!-- Campo de Contraseña Antigua -->
                    <div class="form-group">
                        <label asp-for="Input.OldPassword"></label>
                        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                    </div>

                    <!-- Campo de Nueva Contraseña con Medidor de Seguridad -->
                    <div class="form-group">
                        <label asp-for="Input.NewPassword"></label>
                        <input asp-for="Input.NewPassword" class="form-control" id="newPassword" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        <small id="password-strength-text" class="form-text"></small>
                        <div class="progress mt-2">
                            <div id="password-strength-meter" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                        </div>
                    </div>

                    <!-- Campo para Confirmar la Nueva Contraseña -->
                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Actualizar</button>
                </form>
            </div>
            <!-- Lista de Condiciones de Contraseña -->
            <div class="col-md-4">
                <div class="password-rules mt-4">
                    <h5>Condiciones de la Contraseña</h5>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-check-circle text-success"></i> Mínimo 6 caracteres</li>
                        <li><i class="fas fa-check-circle text-success"></i> Al menos una letra mayúscula</li>
                        <li><i class="fas fa-check-circle text-success"></i> Al menos una letra minúscula</li>
                        <li><i class="fas fa-check-circle text-success"></i> Al menos un número</li>
                        <li><i class="fas fa-check-circle text-success"></i> Al menos un carácter especial</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const passwordInput = document.getElementById('newPassword');
    const strengthMeter = document.getElementById('password-strength-meter');
    const strengthText = document.getElementById('password-strength-text');

    passwordInput.addEventListener('input', function () {
        const strength = calculatePasswordStrength(passwordInput.value);
        updatePasswordStrengthUI(strength);
    });

    function calculatePasswordStrength(password) {
        let strength = 0;

        if (password.length >= 6) strength += 1; // Longitud mínima
        if (/[A-Z]/.test(password)) strength += 1; // Al menos una letra mayúscula
        if (/[a-z]/.test(password)) strength += 1; // Al menos una letra minúscula
        if (/[0-9]/.test(password)) strength += 1; // Al menos un número
        if (/[^A-Za-z0-9]/.test(password)) strength += 1; // Al menos un carácter especial

        return strength;
    }

    function updatePasswordStrengthUI(strength) {
        const strengthLevels = ["Muy débil", "Débil", "Aceptable", "Fuerte", "Muy fuerte"];
        const strengthColors = ["#dc3545", "#fd7e14", "#ffc107", "#28a745", "#007bff"];

        strengthText.textContent = strengthLevels[strength];
        strengthMeter.style.width = `${(strength / 5) * 100}%`;
        strengthMeter.style.backgroundColor = strengthColors[strength];
    }
</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}
